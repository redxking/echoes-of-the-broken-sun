+#include "EchoesSimCore/Simulation.h"
+#include <algorithm>
+#include <iostream>
+#include <stdexcept>
+using namespace echoes::sim;
+#define CHECK(x) do { if (!(x)) throw std::runtime_error(#x); } while (false)
+
+void CheckDeposit(PlayerId owner, Faction faction, int stock) {
+    Simulation sim(SimulationConfig{32,32,20,0xDE910ULL});
+    CHECK(sim.AddPlayer(0, faction, ResourcePool{0,0}));
+    CHECK(sim.AddPlayer(1, faction, ResourcePool{0,0}));
+    CHECK(sim.SpawnEntity(owner, faction, EntityType::CommandCore, Vec2::FromTiles(4,8)));
+    const auto node = sim.SpawnResourceNode(Vec2::FromTiles(10,8),stock);
+    const auto other = sim.SpawnResourceNode(Vec2::FromTiles(11,8),50);
+    const auto hidden = sim.SpawnResourceNode(Vec2::FromTiles(30,30),80);
+    const auto worker = sim.SpawnEntity(owner,faction,EntityType::Worker,Vec2::FromTiles(10,8));
+    CHECK(worker && node && other && hidden);
+    sim.Step();
+    const auto view = sim.CreatePlayerView(owner);
+    CHECK(view.has_value());
+    const auto seen = std::find_if(view->Entities().begin(), view->Entities().end(),
+        [node](const Entity& e){ return e.id == node; });
+    CHECK(seen != view->Entities().end());
+    CHECK(seen->resourceRemaining == stock);
+    CHECK(std::none_of(view->Entities().begin(),view->Entities().end(),
+        [hidden](const Entity& e){return e.id == hidden;}));
+    Command gather{}; gather.executeTick=sim.CurrentTick(); gather.player=owner;
+    gather.sequence=1; gather.type=CommandType::Gather; gather.actor=worker; gather.target=node;
+    CHECK(sim.QueueCommand(gather));
+    sim.Step(10);
+    std::string error;
+    auto restored=Simulation::LoadSnapshot(sim.SaveSnapshot(), &error);
+    CHECK(restored.has_value());
+    int previous=sim.FindEntity(node)->resourceRemaining;
+    for (int tick=0;tick<20000 && sim.FindPlayer(owner)->resources.material<stock;++tick) {
+        sim.Step(); restored->Step();
+        const auto* n=sim.FindEntity(node); const auto* w=sim.FindEntity(worker);
+        CHECK(n && w); CHECK(n->resourceRemaining>=0 && n->resourceRemaining<=previous);
+        CHECK(n->resourceRemaining+w->cargo+sim.FindPlayer(owner)->resources.material==stock);
+        previous=n->resourceRemaining;
+    }
+    CHECK(sim.FindEntity(node)->resourceRemaining==0);
+    CHECK(sim.FindPlayer(owner)->resources.material==stock);
+    CHECK(sim.FindEntity(worker)->cargo==0);
+    CHECK(sim.FindEntity(worker)->harvestState==HarvestState::Idle);
+    CHECK(sim.FindEntity(other)->resourceRemaining==50);
+    CHECK(sim.StateChecksum()==restored->StateChecksum());
+    auto exhausted=Simulation::LoadSnapshot(sim.SaveSnapshot(), &error);
+    CHECK(exhausted.has_value());
+    sim.Step(100); exhausted->Step(100);
+    CHECK(sim.FindPlayer(owner)->resources.material==stock);
+    CHECK(sim.StateChecksum()==exhausted->StateChecksum());
+}
+int main() {
+    try {
+        for (auto faction : {Faction::MeridianCompact,Faction::KharuunAssemblies,Faction::HollowChoir})
+            for (PlayerId owner : {PlayerId{0},PlayerId{1}}) CheckDeposit(owner,faction,17);
+        CheckDeposit(0,Faction::MeridianCompact,1500);
+        std::cout << "PASS: 7 deposit cases; public stock, hidden exclusion, conservation, partial final loads, depletion, idle, save/load.\n";
+    } catch(const std::exception& e) { std::cerr << "FAIL: " << e.what() << '\n'; return 1; }
+}
