+++ b/ArtSource/tools/ebs_composite.py
@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+"""ebs_composite.py — measure and composite a baked texture set (numpy + Pillow).
+
+Author: Angelis Pseftis.
+
+Runs in the art venv (~/.venvs/ebs-art), NOT in the deterministic stdlib pipeline: the generators and
+ebs_texbake stay standard-library only so their recorded hashes remain valid. This tool consumes their
+output and Unreal's bakes, and produces corrected maps plus a measurement report.
+
+It exists because the two open regressions are both quantities, not opinions:
+  PF-026  a curvature lift applied in the MATERIAL blew the chamfer rims to near-white and took the
+          body from 0.33x to 0.37x the ground. Here the lift is composited offline and its gain is
+          SOLVED so the painted body stays inside the Charcoal anchor (0.02-0.07 linear).
+  PF-025  the team band's texel share grew when the UVs were regenerated. Here it is measured on both
+          layouts and eroded to the authored share.
+
+Texel share is only a PROXY for world-area share: it is exact on the blockout's uniform-density atlas
+and approximate on patch-builder UVs, where texel density varies. The report says which it measured.
+
+Usage:
+  ~/.venvs/ebs-art/bin/python ebs_composite.py --detail-dir <dir> --prefix T_... [--reference-dir <dir>]
+                                               [--anchor-low 0.02 --anchor-high 0.07] [--write]
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+
+import numpy as np
+from PIL import Image
+
+AUTHOR = "Angelis Pseftis"
+TOOL_REVISION = "ebs-composite-v1"
+
+
+def load(path):
+    return np.asarray(Image.open(path).convert("RGB"), dtype=np.float32) / 255.0
+
+
+def srgb_to_linear(c):
+    return np.where(c <= 0.04045, c / 12.92, ((c + 0.055) / 1.055) ** 2.4)
+
+
+def linear_to_srgb(c):
+    c = np.clip(c, 0.0, 1.0)
+    return np.where(c <= 0.0031308, c * 12.92, 1.055 * c ** (1 / 2.4) - 0.055)
+
+
+def luminance(linear_rgb):
+    return linear_rgb @ np.array([0.2126, 0.7152, 0.0722], dtype=np.float32)
+
+
+def painted_mask(base_srgb, background=(0.5, 0.5, 0.5), tol=0.02):
+    """Texels a chart actually painted: the baker leaves everything else at neutral grey."""
+    bg = np.array(background, dtype=np.float32)
+    return np.any(np.abs(base_srgb - bg) > tol, axis=2)
+
+
+def measure(maps, mask, label):
+    base_lin = srgb_to_linear(maps["BaseColor"])
+    lum = luminance(base_lin)[mask]
+    out = {"label": label, "painted_texels": int(mask.sum()),
+           "body_luminance_linear": {"min": float(lum.min()), "median": float(np.median(lum)),
+                                     "p95": float(np.percentile(lum, 95)), "max": float(lum.max())}}
+    if "MRE" in maps:
+        emissive = maps["MRE"][..., 2][mask] > 0.004
+        out["emissive_texel_share_of_painted"] = float(emissive.mean())
+    if "StateMask" in maps:
+        team = maps["StateMask"][..., 2][mask] > 0.5
+        out["team_texel_share_of_painted"] = float(team.mean())
+        sweep = maps["StateMask"][..., 0][mask]
+        out["sweep_levels"] = int(len(np.unique(np.round(sweep * 255).astype(np.int32))))
+    return out
+
+
+def solve_curvature_gain(base_lin, curvature, mask, anchor_high, max_gain=1.2, steps=49):
+    """Largest edge lift whose painted p99 luminance still sits inside the Charcoal anchor."""
+    edge = (curvature - 0.5) * 2.0
+    edge = np.clip(edge, 0.0, 1.0)
+    rows = []
+    chosen = 0.0
+    for gain in np.linspace(0.0, max_gain, steps):
+        lifted = base_lin + edge[..., None] * gain * 0.06
+        p99 = float(np.percentile(luminance(lifted)[mask], 99))
+        rows.append({"gain": round(float(gain), 4), "p99_linear": round(p99, 5), "inside": bool(p99 <= anchor_high)})
+        if p99 <= anchor_high:
+            chosen = float(gain)
+    return chosen, rows
+
+
+def erode(mask, iterations):
+    """Binary erosion with a 4-neighbour structuring element; keeps a band a band."""
+    out = mask.copy()
+    for _ in range(iterations):
+        shifted = np.ones_like(out)
+        shifted[1:, :] &= out[:-1, :]
+        shifted[:-1, :] &= out[1:, :]
+        shifted[:, 1:] &= out[:, :-1]
+        shifted[:, :-1] &= out[:, 1:]
+        out = out & shifted
+    return out
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--detail-dir", required=True)
+    parser.add_argument("--prefix", required=True)
+    parser.add_argument("--reference-dir", help="the blockout's atlas maps, for the authored shares")
+    parser.add_argument("--anchor-low", type=float, default=0.02)
+    parser.add_argument("--anchor-high", type=float, default=0.07)
+    parser.add_argument("--ao-strength", type=float, default=0.85)
+    parser.add_argument("--write", action="store_true")
+    args = parser.parse_args()
+
+    def path(directory, suffix, prefix=None):
+        return os.path.join(directory, f"{prefix or args.prefix}{suffix}.png")
+
+    maps = {}
+    for name, suffix in (("BaseColor", "_DetailBaseColor"), ("MRE", "_DetailMRE"),
+                         ("StateMask", "_DetailStateMask"), ("AO", "_DetailAO"),
+                         ("Curvature", "_DetailCurvature"), ("Normal", "_DetailNormal")):
+        p = path(args.detail_dir, suffix)
+        if os.path.exists(p):
+            maps[name] = load(p)
+    if "BaseColor" not in maps:
+        print(json.dumps({"error": "no BaseColor in " + args.detail_dir})); return 2
+
+    report = {"author": AUTHOR, "tool_revision": TOOL_REVISION,
+              "anchor": {"low": args.anchor_low, "high": args.anchor_high,
+                         "source": "Docs/ArtDirection.md Charcoal anchor, linear"},
+              "texel_share_caveat": ("Texel share is exact on the blockout's uniform-density atlas and only a "
+                                     "PROXY on patch-builder UVs, where texel density varies across the mesh.")}
+    mask = painted_mask(maps["BaseColor"])
+    report["detail_before"] = measure(maps, mask, "detail maps, as baked")
+
+    if args.reference_dir:
+        ref = {}
+        for name, suffix in (("BaseColor", "_BaseColor"), ("MRE", "_MRE"), ("StateMask", "_StateMask")):
+            p = path(args.reference_dir, suffix)
+            if os.path.exists(p):
+                ref[name] = load(p)
+        if "BaseColor" in ref:
+            ref_mask = painted_mask(ref["BaseColor"])
+            report["reference_atlas"] = measure(ref, ref_mask, "blockout atlas (authored, uniform density)")
+
+    base_lin = srgb_to_linear(maps["BaseColor"])
+    composited = base_lin.copy()
+
+    if "AO" in maps:
+        ao = maps["AO"][..., 0]
+        composited *= (1.0 - args.ao_strength * (1.0 - ao))[..., None]
+        report["ao_applied"] = {"strength": args.ao_strength}
+
+    if "Curvature" in maps:
+        gain, rows = solve_curvature_gain(composited, maps["Curvature"][..., 0], mask, args.anchor_high)
+        edge = np.clip((maps["Curvature"][..., 0] - 0.5) * 2.0, 0.0, 1.0)
+        composited = composited + edge[..., None] * gain * 0.06
+        report["curvature_lift"] = {"solved_gain": gain, "sweep": rows[::6],
+                                    "rule": "largest gain whose painted p99 luminance stays inside the anchor"}
+
+    corrected = dict(maps)
+    corrected["BaseColor"] = linear_to_srgb(composited)
+
+    if "StateMask" in maps and report.get("reference_atlas"):
+        want = report["reference_atlas"].get("team_texel_share_of_painted")
+        have = report["detail_before"].get("team_texel_share_of_painted")
+        if want is not None and have is not None and have > want * 1.15:
+            team = (maps["StateMask"][..., 2] > 0.5) & mask
+            best, iterations = team, 0
+            for k in range(1, 25):
+                candidate = erode(team, k)
+                share = candidate[mask].mean()
+                best, iterations = candidate, k
+                if share <= want:
+                    break
+            state = corrected["StateMask"].copy()
+            state[..., 2] = np.where(best, 1.0, 0.0)
+            corrected["StateMask"] = state
+            report["team_band_correction"] = {"authored_share": want, "as_baked": have,
+                                              "erosion_iterations": iterations,
+                                              "corrected_share": float(best[mask].mean())}
+
+    # The transfer bake INTERPOLATES: StateMask.R arrived as 254 continuous levels where the blockout
+    # authored 10 discrete molt-sweep orders, so the texture mirror no longer agreed with COLOR_0.R.
+    # Snap every texel back to the nearest authored level (owner ruling: they must not disagree).
+    if "StateMask" in corrected and report.get("reference_atlas"):
+        ref_state = ref.get("StateMask") if "ref" in dir() else None
+        if ref_state is not None:
+            levels = np.unique(np.round(ref_state[..., 0][painted_mask(ref["BaseColor"])] * 255).astype(np.int32)) / 255.0
+            if 1 < len(levels) <= 64:
+                state = corrected["StateMask"].copy()
+                sweep = state[..., 0]
+                snapped = levels[np.argmin(np.abs(sweep[..., None] - levels[None, None, :]), axis=2)]
+                state[..., 0] = np.where(final_mask_pre := painted_mask(corrected["BaseColor"]), snapped, sweep)
+                corrected["StateMask"] = state
+                report["sweep_quantisation"] = {"authored_levels": [round(float(x), 4) for x in levels],
+                                                "levels_before": report["detail_before"]["sweep_levels"],
+                                                "rule": "StateMask.R must mirror COLOR_0.R, not a smoothed version of it"}
+    final_mask = painted_mask(corrected["BaseColor"])
+    report["detail_after"] = measure(corrected, final_mask, "detail maps, composited")
+
+    if args.write:
+        written = {}
+        for name, suffix in (("BaseColor", "_CompBaseColor"), ("StateMask", "_CompStateMask")):
+            if name in corrected:
+                out = os.path.join(args.detail_dir, f"{args.prefix}{suffix}.png")
+                Image.fromarray((np.clip(corrected[name], 0, 1) * 255 + 0.5).astype(np.uint8)).save(out)
+                written[name] = os.path.basename(out)
+        report["written"] = written
+    with open(os.path.join(args.detail_dir, "composite-report.json"), "w", encoding="utf-8") as handle:
+        json.dump(report, handle, indent=1)
+    print(json.dumps({k: report[k] for k in ("detail_before", "reference_atlas", "curvature_lift",
+                                             "team_band_correction", "detail_after", "written")
+                      if k in report}, indent=1))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
