{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Echoes concept register schema",
  "description": "Author: Angelis Pseftis. Structural validation; semantic source/ID checks are in audit.py.",
  "type": "object",
  "required": [
    "author",
    "creator",
    "schema_version",
    "concept_objects",
    "asset_families",
    "text_only_specifications",
    "production_assets",
    "decisions"
  ],
  "properties": {
    "author": {
      "const": "Angelis Pseftis"
    },
    "creator": {
      "const": "Angelis Pseftis"
    },
    "schema_version": {
      "const": 1
    },
    "concept_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "production_asset_id",
          "display_name",
          "source_refs",
          "domain",
          "object_type",
          "canon_status",
          "production_maturity",
          "gameplay_mapping",
          "visual_description",
          "silhouette_requirements",
          "dimensions",
          "material_language",
          "team_readability",
          "animation_rigging",
          "construction_behavior",
          "state_changes",
          "damage_destruction",
          "vfx_requirements",
          "audio_interfaces",
          "collision_navigation",
          "nanite_lod",
          "texture_material_budget",
          "rts_readability_status",
          "performance_validation_status",
          "future_unreal_destination",
          "provenance_rights",
          "dependencies",
          "open_decisions",
          "notes",
          "visual_use_status",
          "replacement_assessment",
          "owner_visual_selection_evidence"
        ],
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^EBS-CON-(MER|KHA|HOL|WRL|FWL|GLS|CHR|UIX)-(BLD|UNT|VEH|ENV|PRP|SYS|CHR|VFX|UI)-[0-9]{3,}$"
          },
          "production_asset_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^EBS-[A-Z]{3}-[A-Z]{2,3}-[0-9]{3,}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "source_repository_path",
                "source_sha256",
                "source_commit",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "source_repository_path": {
                  "type": "string"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox_normalized": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "domain": {
            "enum": [
              "MER",
              "KHA",
              "HOL",
              "WRL",
              "FWL",
              "GLS",
              "CHR",
              "UIX"
            ]
          },
          "object_type": {
            "enum": [
              "BLD",
              "UNT",
              "VEH",
              "ENV",
              "PRP",
              "SYS",
              "CHR",
              "VFX",
              "UI"
            ]
          },
          "canon_status": {
            "enum": [
              "CANDIDATE",
              "CANON_APPROVED",
              "EXPLORATORY",
              "SUPERSEDED",
              "UNKNOWN"
            ]
          },
          "production_maturity": {
            "enum": [
              "ART_ALPHA",
              "ART_BETA",
              "BLOCKOUT",
              "GAMEPLAY_PROXY",
              "NOT_STARTED",
              "PRODUCTION",
              "REFERENCE_READY",
              "UE_INTEGRATED",
              "VERIFIED"
            ]
          },
          "gameplay_mapping": {
            "type": "object",
            "required": [
              "status",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "SUPPORTED",
                  "UNMAPPED"
                ]
              },
              "evidence": {
                "type": "array"
              }
            }
          },
          "visual_description": {},
          "silhouette_requirements": {},
          "dimensions": {},
          "material_language": {},
          "team_readability": {},
          "animation_rigging": {},
          "construction_behavior": {},
          "state_changes": {},
          "damage_destruction": {},
          "vfx_requirements": {},
          "audio_interfaces": {},
          "collision_navigation": {},
          "nanite_lod": {},
          "texture_material_budget": {},
          "rts_readability_status": {},
          "performance_validation_status": {},
          "future_unreal_destination": {},
          "provenance_rights": {},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_decisions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {},
          "visual_use_status": {
            "enum": [
              "UNSELECTED",
              "REFERENCE_ONLY",
              "PLACEHOLDER",
              "SELECTED_FOR_PRODUCTION"
            ]
          }
        }
      }
    },
    "asset_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family_id",
          "states",
          "member_concept_ids"
        ],
        "properties": {
          "family_id": {
            "type": "string"
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "member_concept_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "text_only_specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "spec_id",
          "name",
          "source",
          "visual_source_status"
        ],
        "properties": {
          "spec_id": {
            "type": "string"
          }
        }
      }
    },
    "production_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "production_asset_id",
          "concept_ids",
          "provenance"
        ],
        "properties": {
          "production_asset_id": {
            "type": "string"
          },
          "concept_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_id",
          "title",
          "status",
          "observation",
          "next_action",
          "evidence"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^DEC-[0-9]{3,}$"
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "DEFERRED"
            ]
          }
        }
      }
    }
  }
}
