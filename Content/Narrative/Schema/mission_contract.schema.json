{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echoes://narrative/schema/mission-contract-v2",
  "title": "Echoes Authored Mission Narrative Contract",
  "$defs": {
    "text_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_characters",
        "localization_expansion_percent"
      ],
      "properties": {
        "max_characters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 320
        },
        "localization_expansion_percent": {
          "type": "integer",
          "minimum": 20,
          "maximum": 50
        }
      }
    },
    "placeholders": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "localized_text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "loc_key",
        "source_text",
        "placeholders",
        "text_budget",
        "binding_status"
      ],
      "properties": {
        "id": {
          "pattern": "^nar_[a-z0-9_]+$"
        },
        "loc_key": {
          "pattern": "^nar_[a-z0-9_]+$"
        },
        "source_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "placeholders": {
          "$ref": "#/$defs/placeholders"
        },
        "text_budget": {
          "$ref": "#/$defs/text_budget"
        },
        "binding_status": {
          "const": "authored_unbound"
        }
      }
    },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "faction_id",
        "role_in_mission",
        "command_authority",
        "delivery_channel",
        "physical_presence_status",
        "voice_asset_status"
      ],
      "properties": {
        "id": {
          "pattern": "^spk_[a-z0-9_]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "faction_id": {
          "enum": [
            "meridian_compact",
            "kharuun_assemblies",
            "hollow_choir"
          ]
        },
        "role_in_mission": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "command_authority": {
          "type": "boolean"
        },
        "delivery_channel": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "physical_presence_status": {
          "const": "not_asserted_by_contract"
        },
        "voice_asset_status": {
          "const": "absent"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runtime_signal",
        "prerequisite_ids",
        "occurrence",
        "reset_behavior",
        "binding_status"
      ],
      "properties": {
        "id": {
          "pattern": "^nar_m(0[1-9]|1[0-5])_evt_[a-z0-9_]+$"
        },
        "runtime_signal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "prerequisite_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "pattern": "^nar_m(0[1-9]|1[0-5])_evt_[a-z0-9_]+$"
          }
        },
        "occurrence": {
          "enum": [
            "once_per_attempt",
            "once_per_completion",
            "repeatable_after_failure"
          ]
        },
        "reset_behavior": {
          "enum": [
            "reset_on_mission_retry",
            "reset_on_mission_replay",
            "starts_new_mission_attempt"
          ]
        },
        "binding_status": {
          "const": "authored_unbound"
        }
      }
    },
    "voice_hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_status"
      ],
      "properties": {
        "id": {
          "pattern": "^aud_m(0[1-9]|1[0-5])_vo_[a-z0-9_]+$"
        },
        "asset_status": {
          "const": "absent"
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "loc_key",
        "speaker_id",
        "trigger_id",
        "delivery_channel",
        "source_text",
        "placeholders",
        "text_budget",
        "subtitle",
        "transcript_included",
        "voice_hook",
        "binding_status"
      ],
      "properties": {
        "id": {
          "pattern": "^nar_m(0[1-9]|1[0-5])_line_[a-z0-9_]+$"
        },
        "loc_key": {
          "pattern": "^nar_m(0[1-9]|1[0-5])_line_[a-z0-9_]+$"
        },
        "speaker_id": {
          "pattern": "^spk_[a-z0-9_]+$"
        },
        "trigger_id": {
          "pattern": "^nar_m(0[1-9]|1[0-5])_evt_[a-z0-9_]+$"
        },
        "delivery_channel": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "placeholders": {
          "$ref": "#/$defs/placeholders"
        },
        "text_budget": {
          "$ref": "#/$defs/text_budget"
        },
        "subtitle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "timing_status"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "timing_status": {
              "const": "unassigned"
            }
          }
        },
        "transcript_included": {
          "const": true
        },
        "voice_hook": {
          "$ref": "#/$defs/voice_hook"
        },
        "binding_status": {
          "const": "authored_unbound"
        }
      }
    },
    "dialogue_sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "beat",
        "trigger_id",
        "line_ids",
        "binding_status"
      ],
      "properties": {
        "id": {
          "pattern": "^nar_m(0[1-9]|1[0-5])_seq_[a-z0-9_]+$"
        },
        "beat": {
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "trigger_id": {
          "pattern": "^nar_m(0[1-9]|1[0-5])_evt_[a-z0-9_]+$"
        },
        "line_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^nar_m(0[1-9]|1[0-5])_line_[a-z0-9_]+$"
          }
        },
        "binding_status": {
          "const": "authored_unbound"
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice",
        "current_runtime_behavior",
        "design_target_tradeoff",
        "runtime_alignment",
        "trigger_id",
        "dialogue_line_ids",
        "design_target_choice_ui",
        "binding_status"
      ],
      "properties": {
        "choice": {
          "$comment": "Seven approved branch choices: the three well choices (m01, m10) and the four campaign resolutions (m15).",
          "enum": [
            "Harvest",
            "Preserve",
            "Reshape",
            "Restoration",
            "ControlledStabilization",
            "Extinguishment",
            "OpenEvolution"
          ]
        },
        "current_runtime_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "design_target_tradeoff": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "runtime_alignment": {
          "enum": [
            "requires_telegraph_before_binding",
            "bounded_values_aligned_runtime_consumption_unimplemented",
            "requires_telegraph_and_expiry_warning_before_binding"
          ]
        },
        "trigger_id": {
          "$comment": "Authored branch triggers: nar_m01_evt_well_decision_committed, nar_m10_evt_protocol_committed, nar_m15_evt_resolution_selected.",
          "type": "string",
          "pattern": "^nar_m(0[1-9]|1[0-5])_evt_[a-z0-9_]+$"
        },
        "dialogue_line_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "pattern": "^nar_m(0[1-9]|1[0-5])_line_[a-z0-9_]+$"
          },
          "$comment": "m01 authors three lines per branch; m10 and m15 author two."
        },
        "design_target_choice_ui": {
          "$ref": "#/$defs/localized_text"
        },
        "binding_status": {
          "const": "authored_unbound"
        }
      }
    },
    "result_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "copy"
      ],
      "properties": {
        "status": {
          "enum": [
            "Added",
            "AlreadyRecorded",
            "ReplayConflict",
            "StorageFailure"
          ]
        },
        "copy": {
          "$ref": "#/$defs/localized_text"
        }
      }
    },
    "failure_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason_code",
        "source_condition",
        "binding_status",
        "dialogue_line_ids"
      ],
      "properties": {
        "id": {
          "pattern": "^nar_m(0[1-9]|1[0-5])_fail_[a-z0-9_]+$"
        },
        "reason_code": {
          "$comment": "Per-mission vocabulary (32 codes across the fifteen). Exact per-mission sets are pinned by validate_narrative.py and matched 15/15 against EchoesSimulationSubsystem.cpp:9578.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "binding_status": {
          "enum": [
            "reason_code_requested",
            "fallback_available"
          ]
        },
        "dialogue_line_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "pattern": "^nar_m(0[1-9]|1[0-5])_line_[a-z0-9_]+$"
          }
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "editorial_target_seconds",
        "visual_direction",
        "line_ids",
        "visual_hook_ids",
        "audio_hook_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^nar_m(0[1-9]|1[0-5])_shot_[a-z0-9_]+$"
        },
        "editorial_target_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "visual_direction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "line_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^nar_m(0[1-9]|1[0-5])_line_[a-z0-9_]+$"
          }
        },
        "visual_hook_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^vis_m(0[1-9]|1[0-5])_[a-z0-9_]+$"
          }
        },
        "audio_hook_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "pattern": "^aud_m(0[1-9]|1[0-5])_[a-z0-9_]+$"
          }
        }
      }
    },
    "asset_hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "asset_status",
        "binding_status"
      ],
      "properties": {
        "id": {
          "pattern": "^(aud|vis)_m(0[1-9]|1[0-5])_[a-z0-9_]+$"
        },
        "kind": {
          "enum": [
            "audio",
            "visual"
          ]
        },
        "asset_status": {
          "const": "absent"
        },
        "binding_status": {
          "const": "unimplemented"
        }
      }
    },
    "tile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tile_by_founding_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harvest",
        "preserve",
        "reshape"
      ],
      "properties": {
        "harvest": {
          "$ref": "#/$defs/tile"
        },
        "preserve": {
          "$ref": "#/$defs/tile"
        },
        "reshape": {
          "$ref": "#/$defs/tile"
        }
      }
    },
    "tile_by_district": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive",
        "life_support",
        "transit"
      ],
      "properties": {
        "archive": {
          "$ref": "#/$defs/tile"
        },
        "life_support": {
          "$ref": "#/$defs/tile"
        },
        "transit": {
          "$ref": "#/$defs/tile"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "content_id",
    "metadata",
    "runtime_binding",
    "canon",
    "speakers",
    "triggers",
    "ui_copy",
    "lines",
    "dialogue_sequences",
    "branch_variants",
    "result_variants",
    "failure_retry",
    "cinematic",
    "asset_hooks",
    "projections",
    "implementation"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "namespace": {
      "const": "echoes.narrative"
    },
    "content_id": {
      "$comment": "Was const holding a regex string (commit 1ca3ad0). Slug generalized: authored ids run nar_m01_what_the_ledger_keeps .. nar_m15_the_broken_sun.",
      "type": "string",
      "pattern": "^nar_m(0[1-9]|1[0-5])_[a-z0-9_]+$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "creator",
        "source_locale",
        "rights_status",
        "originality_review_status",
        "authority_path",
        "content_status"
      ],
      "properties": {
        "author": {
          "const": "Angelis Pseftis"
        },
        "creator": {
          "const": "Angelis Pseftis"
        },
        "source_locale": {
          "const": "en-US"
        },
        "rights_status": {
          "const": "author_attributed_project_source"
        },
        "originality_review_status": {
          "const": "human_review_required"
        },
        "authority_path": {
          "const": "Docs/Archive/DevelopmentBible.md"
        },
        "content_status": {
          "const": "authored_source_only"
        }
      }
    },
    "runtime_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "operation_mode",
        "phases",
        "well_choices",
        "well_uncommitted_state",
        "campaign_commit_statuses",
        "runtime_consumed",
        "localization_runtime_status",
        "failure_reason_binding"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z]+$"
        },
        "operation_mode": {
          "type": "string",
          "pattern": "^Campaign[A-Za-z]+$"
        },
        "phases": {
          "$comment": "Every contract opens on Inactive and carries Complete and Failed; 5-9 phases authored.",
          "type": "array",
          "minItems": 5,
          "maxItems": 9,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "Inactive"
            }
          ],
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]+$"
          },
          "allOf": [
            {
              "contains": {
                "const": "Complete"
              }
            },
            {
              "contains": {
                "const": "Failed"
              }
            }
          ]
        },
        "well_choices": {
          "type": "array",
          "prefixItems": [
            {
              "const": "Harvest"
            },
            {
              "const": "Preserve"
            },
            {
              "const": "Reshape"
            }
          ],
          "items": false
        },
        "well_uncommitted_state": {
          "const": "Dormant"
        },
        "campaign_commit_statuses": {
          "type": "array",
          "prefixItems": [
            {
              "const": "Added"
            },
            {
              "const": "AlreadyRecorded"
            },
            {
              "const": "ReplayConflict"
            },
            {
              "const": "StorageFailure"
            }
          ],
          "items": false
        },
        "runtime_consumed": {
          "const": false
        },
        "localization_runtime_status": {
          "const": "unimplemented"
        },
        "failure_reason_binding": {
          "$comment": "Verified bound: EchoesPlayerController.cpp:5084 passes GetMissionFailureReasonCode(); EchoesSimulationSubsystem.cpp:9578 returns per-mission codes matching every contract's authored reason_code set exactly, both directions, for all fifteen.",
          "const": "bound_runtime"
        }
      }
    },
    "canon": {
      "$comment": "Required = the 7 keys present in all fifteen contracts. The other 51 are mission-specific and optional; the vocabulary stays closed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "purpose",
        "player_pov",
        "command_faction",
        "hidden_moral_score",
        "canonical_facts",
        "prohibited_inferences"
      ],
      "properties": {
        "account_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "archive_carrier_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "authority_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "base_hold_ticks_by_deferred_district": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "archive",
            "life_support",
            "transit"
          ],
          "properties": {
            "archive": {
              "type": "integer",
              "minimum": 0
            },
            "life_support": {
              "type": "integer",
              "minimum": 0
            },
            "transit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "canonical_facts": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "carrier_must_hold_recovery_during_well_commit": {
          "type": "boolean"
        },
        "census_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "civilian_shelter_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "command_faction": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "confluence_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "contact_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "continuance_window_ticks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "convergence_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "crisis_hold_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "district_contribution_sites": {
          "$ref": "#/$defs/tile_by_district"
        },
        "district_sites": {
          "$ref": "#/$defs/tile_by_district"
        },
        "echo_relay_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "evacuation_tile": {
          "$ref": "#/$defs/tile"
        },
        "evidence_extraction_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "extraction_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "first_anchor_site": {
          "$ref": "#/$defs/tile"
        },
        "first_echo_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "first_state_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "first_witness_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "future_well_site": {
          "$ref": "#/$defs/tile"
        },
        "hidden_moral_score": {
          "const": false
        },
        "hold_ticks_delta_by_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "restoration",
            "controlled_stabilization",
            "extinguishment",
            "open_evolution"
          ],
          "properties": {
            "restoration": {
              "type": "integer"
            },
            "controlled_stabilization": {
              "type": "integer"
            },
            "extinguishment": {
              "type": "integer"
            },
            "open_evolution": {
              "type": "integer"
            }
          }
        },
        "hostile_core_destruction_substitutes_for_evacuation": {
          "type": "boolean"
        },
        "kharuun_evidence_site": {
          "$ref": "#/$defs/tile"
        },
        "liability_site_by_deferred_district": {
          "$ref": "#/$defs/tile_by_district"
        },
        "listening_spine_site_by_founding_choice": {
          "$ref": "#/$defs/tile_by_founding_choice"
        },
        "memory_bearer_role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "memory_shard_site_by_founding_choice": {
