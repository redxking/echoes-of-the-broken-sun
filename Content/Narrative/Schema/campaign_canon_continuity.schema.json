{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echoes://narrative/schema/campaign-canon-continuity-v1",
  "title": "Echoes Campaign Canon and Continuity Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "content_id",
    "metadata",
    "campaign",
    "world",
    "characters",
    "missions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "namespace": {
      "const": "echoes.narrative"
    },
    "content_id": {
      "const": "nar_campaign_canon_continuity_v1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "creator",
        "source_locale",
        "authority_path",
        "authority_status",
        "content_status",
        "runtime_consumed"
      ],
      "properties": {
        "author": {
          "const": "Angelis Pseftis"
        },
        "creator": {
          "const": "Angelis Pseftis"
        },
        "source_locale": {
          "const": "en-US"
        },
        "authority_path": {
          "const": "Docs/DevelopmentBible.md"
        },
        "authority_status": {
          "const": "structured_projection_of_authoritative_bible"
        },
        "content_status": {
          "const": "validated_authored_source"
        },
        "runtime_consumed": {
          "const": false
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_count",
        "terminal_mission_id",
        "mission_16_exists",
        "hidden_moral_score",
        "founding_well_doctrine_missions",
        "independent_lume_choice_mission",
        "lume_protocol_receipt_missions",
        "final_resolutions"
      ],
      "properties": {
        "mission_count": {
          "const": 15
        },
        "terminal_mission_id": {
          "const": "TheBrokenSun"
        },
        "mission_16_exists": {
          "const": false
        },
        "hidden_moral_score": {
          "const": false
        },
        "founding_well_doctrine_missions": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "independent_lume_choice_mission": {
          "const": "ChoirAtLumeReach"
        },
        "lume_protocol_receipt_missions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "final_resolutions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Restoration",
              "ControlledStabilization",
              "Extinguishment",
              "OpenEvolution"
            ]
          }
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting",
        "crownfall_rule",
        "future_well_rule",
        "future_well_choices",
        "factions"
      ],
      "properties": {
        "setting": {
          "const": "Soryn"
        },
        "crownfall_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "future_well_rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "future_well_choices": {
          "type": "array",
          "prefixItems": [
            {
              "const": "Harvest"
            },
            {
              "const": "Preserve"
            },
            {
              "const": "Reshape"
            }
          ],
          "items": false
        },
        "factions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "canon",
              "voice_rule",
              "prohibited_reduction"
            ],
            "properties": {
              "id": {
                "enum": [
                  "meridian_compact",
                  "kharuun_assemblies",
                  "hollow_choir"
                ]
              },
              "canon": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "voice_rule": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "prohibited_reduction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "faction_id",
          "arc",
          "mission_ids",
          "continuity_boundary"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "faction_id": {
            "enum": [
              "meridian_compact",
              "kharuun_assemblies",
              "hollow_choir"
            ]
          },
          "arc": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "mission_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "continuity_boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "missions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "title",
          "mission_id",
          "operation_mode",
          "command_authority",
          "command_faction",
          "named_participants",
          "continuity_input",
          "established_output",
          "prohibited_inferences",
          "mechanics_status",
          "narrative_presentation_status"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "mission_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "operation_mode": {
            "pattern": "^Campaign[A-Za-z0-9]+$"
          },
          "command_authority": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "command_faction": {
            "enum": [
              "meridian_compact",
              "kharuun_assemblies",
              "hollow_choir"
            ]
          },
          "named_participants": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "continuity_input": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "established_output": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "prohibited_inferences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "mechanics_status": {
            "const": "bounded_operation_implemented_current_source"
          },
          "narrative_presentation_status": {
            "const": "final_dialogue_cinematics_unqualified"
          }
        }
      }
    }
  }
}
