 "canon": {
  "title": "The Choir at Lume Reach",
  "purpose": "Oruun-of-Seven-Stones commands a Kharuun force at Lume Reach with Mara Vey as an off-map liaison: establish branch-specific contact, re-root the Waystone at the Mission 09 deferred district's liability, raise two Listening Spine anchors in sequence, commit a new Lume Well protocol from all three choices, and reach that protocol's public resolution.",
  "player_pov": "oruun_command_authority",
  "command_faction": "kharuun_assemblies",
  "contact_site_by_founding_choice": {
   "harvest": {
    "x": 18,
    "y": 20
   },
   "preserve": {
    "x": 32,
    "y": 20
   },
   "reshape": {
    "x": 46,
    "y": 20
   }
  },
  "liability_site_by_deferred_district": {
   "life_support": {
    "x": 18,
    "y": 34
   },
   "transit": {
    "x": 32,
    "y": 33
   },
   "archive": {
    "x": 46,
    "y": 34
   }
  },
  "first_anchor_site": {
   "x": 28,
   "y": 39
  },
  "second_anchor_site": {
   "x": 36,
   "y": 39
  },
  "future_well_site": {
   "x": 32,
   "y": 43
  },
  "resolution_site_by_protocol": {
   "harvest": {
    "x": 18,
    "y": 50
   },
   "preserve": {
    "x": 32,
    "y": 50
   },
   "reshape": {
    "x": 46,
    "y": 50
   }
  },
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the Mission 01 founding Well decision for its approach and the Mission 09 allocation for its liability site.",
   "The Harvest founding decision selects the Ashward approach with contact at tile 18,20; Preserve the Held-Vault approach at 32,20; Reshape the Foldward approach at 46,20.",
   "The deferred district's liability stands at tile 18,34 for Life Support, 32,33 for Transit, or 46,34 for Archive.",
   "The two Listening Spine anchors rise in sequence at tiles 28,39 and 36,39, and the Lume Well stands at tile 32,43.",
   "The new Well protocol is committed from all three offered choices, and each protocol's public resolution site differs: Harvest at 18,50, Preserve at 32,50, Reshape at 46,50.",
   "The Reshape protocol's resolution window can expire, failing the attempt.",
   "Losing the local core, Oruun, the Waystone, or the Well, or reaching a terminal engagement outcome, fails the attempt irreversibly, and success records a separate tenth irreversible Well decision."
  ],
  "prohibited_inferences": [
   "The local Choir remains a public contact and infrastructure presence, never playable or commandable.",
   "The mechanically opposing Meridian units are quarantine proxies; their presence does not establish Mara's involvement or Compact-wide action.",
   "No Choir identity, intent, or unified voice is established by the contact.",
   "The committed protocol is not established as the right choice; each carries its own recorded consequence.",
   "No claim about Lume Reach's civilian population follows from the protocol resolution.",
   "The tenth Well decision does not resolve or supersede the founding decision."
  ]
 },
