 "ui_copy": {
  "briefing": {
   "id": "nar_m07_ui_briefing",
   "loc_key": "nar_m07_ui_briefing",
   "source_text": "The Compact lost a census. Our communal memory lost a neighborhood, and lost the memory of losing it. The two silences correspond. Root the Waystone, raise the Spine, set two witnesses where the accounts thin, and Oruun walks to the confluence to hear the shape.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 300,
    "localization_expansion_percent": 30
   },
   "binding_status": "authored_unbound"
  },
  "objectives": [
   {
    "id": "nar_m07_ui_obj_root_waystone",
    "loc_key": "nar_m07_ui_obj_root_waystone",
    "source_text": "Root the Waystone at the hollow's inherited anchor.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 91,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   },
   {
    "id": "nar_m07_ui_obj_raise_spine",
    "loc_key": "nar_m07_ui_obj_raise_spine",
    "source_text": "Raise a Listening Spine over the thinned accounts.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 90,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   },
   {
    "id": "nar_m07_ui_obj_position_witnesses",
    "loc_key": "nar_m07_ui_obj_position_witnesses",
    "source_text": "Position both memory witnesses at their sites.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 86,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   },
   {
    "id": "nar_m07_ui_obj_reach_confluence",
    "loc_key": "nar_m07_ui_obj_reach_confluence",
    "source_text": "Bring Oruun to the confluence while the geometry holds.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 95,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   }
  ]
 },
 "lines": [
  {
   "id": "nar_m07_line_op_silence_001",
   "loc_key": "nar_m07_line_op_silence_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "My accounts remember this district street by street. Then, for one neighborhood, all seven go quiet at once. Seven accounts do not agree on anything. Except, apparently, this.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 215,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_op_silence_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_op_census_002",
   "loc_key": "nar_m07_line_op_census_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Talar's erased census and our curated quiet share a border. I do not know what that correspondence means. I intend to stand where I can hear it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 184,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_op_census_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_op_method_003",
   "loc_key": "nar_m07_line_op_method_003",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Waystone to the anchor, then the Spine. We do this in the old order: anchor, listen, witness, walk.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 139,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_op_method_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_op_witness_004",
   "loc_key": "nar_m07_line_op_witness_004",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Two witnesses, at the two places where the accounts thin. Not to speak. To stand where speaking stopped.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 144,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_op_witness_004",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_rooted_001",
   "loc_key": "nar_m07_line_rooted_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_waystone_rooted",
   "delivery_channel": "command_radio",
   "source_text": "The Waystone holds the anchor. The hollow has a center now, whatever else it is missing.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 128,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_rooted_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_rooted_spine_002",
   "loc_key": "nar_m07_line_rooted_spine_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_waystone_rooted",
   "delivery_channel": "command_radio",
   "source_text": "Raise the Spine. If the silence has a shape, the strata will carry its outline.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 119,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_rooted_spine_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_spine_001",
   "loc_key": "nar_m07_line_spine_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_spine_raised",
   "delivery_channel": "command_radio",
   "source_text": "The Spine is listening. There is something under the quiet — not a voice. The place where a voice was expected.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 151,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_spine_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_spine_witnesses_002",
   "loc_key": "nar_m07_line_spine_witnesses_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_spine_raised",
   "delivery_channel": "command_radio",
   "source_text": "Witnesses to their sites. Slowly. The accounts thin exactly where I asked them to stand, and I do not like what that implies about who curated them.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 188,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_spine_witnesses_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_witnesses_001",
   "loc_key": "nar_m07_line_witnesses_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_witnesses_positioned",
   "delivery_channel": "command_radio",
   "source_text": "Both witnesses are placed. The geometry is complete except for me.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 106,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_witnesses_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_witnesses_walk_002",
   "loc_key": "nar_m07_line_witnesses_walk_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_witnesses_positioned",
   "delivery_channel": "command_radio",
   "source_text": "I will walk the last leg myself. If the silence answers to anyone, it should answer to someone carrying seven ways to disagree with it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 175,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_witnesses_walk_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_complete_confluence_001",
   "loc_key": "nar_m07_line_complete_confluence_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_confluence_reached",
   "delivery_channel": "command_radio",
   "source_text": "I am at the confluence. The witnesses hold, the Spine reads, and the silence has a shape: bounded, deliberate, and older than my accounts.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 178,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_complete_confluence_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_complete_bounds_002",
   "loc_key": "nar_m07_line_complete_bounds_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_confluence_reached",
   "delivery_channel": "command_radio",
   "source_text": "I cannot tell you what was removed, or by whom. I can now tell you where removal stops. That is a smaller fact, and a harder one.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 169,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_complete_bounds_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_complete_record_003",
   "loc_key": "nar_m07_line_complete_record_003",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_confluence_reached",
   "delivery_channel": "command_radio",
   "source_text": "Enter the outline in the accounts. All seven. Let them disagree about everything but the border.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 136,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_complete_record_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_fail_core_001",
   "loc_key": "nar_m07_line_fail_core_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The command core is gone. The geometry cannot be held without authority behind it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 122,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_fail_core_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_fail_oruun_002",
   "loc_key": "nar_m07_line_fail_oruun_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "I am cut off from the walk. The confluence keeps its shape unheard.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 107,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_fail_oruun_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_fail_waystone_003",
   "loc_key": "nar_m07_line_fail_waystone_003",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The Waystone is destroyed. The hollow loses its center, and the listening geometry with it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 131,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m07_vo_fail_waystone_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m07_line_fail_witness_004",
   "loc_key": "nar_m07_line_fail_witness_004",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m07_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "We lost a witness. The silence stays unmeasured; I will not pretend two ears were one.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 126,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
