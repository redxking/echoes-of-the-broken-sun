 "canon": {
  "title": "The Shape of Silence",
  "purpose": "Oruun-of-Seven-Stones follows the correspondence between an erased census and curated omissions in Kharuun communal memory: root the Waystone at the hollow's anchor, raise a Listening Spine, position two memory witnesses, and reach the confluence himself.",
  "player_pov": "oruun_command_authority",
  "command_faction": "kharuun_assemblies",
  "waystone_anchor_by_founding_choice": {
