 "canon": {
  "title": "Assembly of the Missing",
  "purpose": "Oruun-of-Seven-Stones and a distinct Kharuun verifier establish paired readback at the neutral Meridian and Kharuun public-record interfaces, an ordinary worker raises a Listening Spine within reach of the neutral Crownfall public index, and both then complete one public observation receipt from separate assembly witness sites.",
  "player_pov": "oruun_command_authority",
  "command_faction": "kharuun_assemblies",
  "spine_link_distance_tiles": 3,
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the exact twelve-record ledger; its sites derive from the Mission 11 and Mission 12 plans.",
   "The public-record readback interfaces are the neutral Meridian and Kharuun sites carried from the Mission 12 plan.",
   "The Crownfall public index stands at the Mission 11 coalition rally site, and the Listening Spine must rise within three tiles of it.",
   "Command authority stays bounded to Oruun; the verifier is a distinct Kharuun unit, and readback is established by both at separate interfaces.",
   "After the durable link exists, Oruun and the verifier move to separate assembly witness sites and complete one public observation receipt.",
   "The result records public readback, Crownfall linkage, and paired observation only.",
   "Losing the local core, Oruun, the verifier, or a public interface, or reaching a terminal engagement outcome, fails the attempt irreversibly."
  ],
  "prohibited_inferences": [
   "No authorship or responsibility for the missing is assigned by the assembly.",
   "No consent or trust between factions or with the missing is established.",
   "Civilian or survivor state beyond the bounded receipt is not modeled and may not be claimed.",
   "The observation receipt is not cryptographic proof of anything beyond its own completion.",
   "No mixed-faction command is created; the Hollow Choir is not made playable.",
   "The assembly does not resolve the Kharuun memory dispute or the census erasures."
  ]
 },
