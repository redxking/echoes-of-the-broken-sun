    "loc_key": "nar_m13_ui_obj_establish_readback",
    "source_text": "Establish paired readback at both public-record interfaces.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 99,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   },
   {
    "id": "nar_m13_ui_obj_link_index",
    "loc_key": "nar_m13_ui_obj_link_index",
    "source_text": "Raise a Listening Spine within three tiles of the Crownfall index.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 106,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   },
   {
    "id": "nar_m13_ui_obj_observe_assembly",
    "loc_key": "nar_m13_ui_obj_observe_assembly",
    "source_text": "Complete one public observation receipt from separate witness sites.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 108,
