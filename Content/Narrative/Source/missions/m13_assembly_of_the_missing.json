 "result_variants": [
  {
   "status": "Added",
   "copy": {
    "id": "nar_m13_result_added",
    "loc_key": "nar_m13_result_added",
    "source_text": "The observation receipt is recorded: paired readback, a durable Crownfall link, and an assembly witnessed from separate sites onto the public record. Who the missing are remains exactly as open as before — but no longer deniable.",
    "placeholders": {},
