   "loc_key": "nar_m13_ui_briefing",
   "source_text": "The missing have an assembly, and the assembly has no record. Establish paired readback at both public-record interfaces, raise a Listening Spine within reach of the Crownfall index, and complete one public observation receipt from separate witness sites.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 300,
    "localization_expansion_percent": 30
   },
   "binding_status": "authored_unbound"
  },
  "objectives": [
