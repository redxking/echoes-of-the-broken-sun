 "canon": {
  "title": "The Broken Sun",
  "purpose": "Neme commands the local Hollow Choir through the Crownfall's final contract while Mara, Oruun, and Talar stand protected as witnesses: secure the approach with an Approach Anchor, assemble the three-faction accord, confirm one eligible ending twice, raise that ending's distinct Resolution Conduit, and hold the exact contract for its route-dependent duration.",
  "player_pov": "neme_command_authority",
  "command_faction": "hollow_choir",
  "base_hold_ticks_by_deferred_district": {
   "life_support": 320,
   "transit": 280,
   "archive": 240
  },
  "hold_ticks_delta_by_resolution": {
   "restoration": 80,
   "controlled_stabilization": 0,
   "extinguishment": 40,
   "open_evolution": 120
  },
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the exact fourteen-record ledger and retains twenty-seven plans from the doctrine, powered-district, and Lume-protocol axes.",
   "The earned endings are an explicit subset: Controlled Stabilization is always available; Restoration requires the Preserve protocol with Life Support powered; Extinguishment requires Harvest doctrine or protocol; Open Evolution requires Reshape doctrine or protocol.",
   "The accord sites, approach anchor, and final convergence derive from the prior plans, and the ordered objectives can never be satisfied by one structure.",
   "The selected ending must be confirmed twice before its Resolution Conduit may rise, and each ending's conduit stands at a distinct convergence offset.",
   "The hold duration is route-dependent: a base of 320, 280, or 240 fixed ticks by deferred district, plus 80 for Restoration, 0 for Controlled Stabilization, 40 for Extinguishment, or 120 for Open Evolution.",
   "The force, all three witnesses, the local core, and the nonterminal world are protected from the first fixed step; the anchor, accord, eligibility, and conduit each become irreversible in turn.",
   "Any applicable breach fails irreversibly, and success records only the selected ending and its availability context."
  ],
  "prohibited_inferences": [
   "The unchosen endings do not occur and their consequences remain unresolved.",
   "No ending is the canonical or correct resolution; the ledger records which was earned and selected, not which was right.",
   "Wider social consequences of the selected ending are not modeled and may not be claimed.",
   "The witnesses' presence does not assert their factions' consent to the selected ending.",
   "The Choir's fate beyond the selected ending's recorded contract is not established.",
   "Completion does not turn the campaign's chain of bounded records into a claim of moral resolution."
  ]
 },
