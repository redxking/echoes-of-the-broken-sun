 "canon": {
  "title": "The Future That Won",
  "purpose": "Oruun-of-Seven-Stones and a distinct Kharuun verifier establish independent readback at the neutral public interfaces, verify the two recorded district inputs, bind only the recorded protocol at the separate Future Well, hold its activation stable for the fixed window, and observe both district readbacks — while Chancellor Rhyse is present only as attributable public demonstrator apparatus.",
  "player_pov": "oruun_command_authority",
  "command_faction": "kharuun_assemblies",
  "readback_sites": {
   "meridian": {
    "x": 26,
    "y": 43
   },
   "kharuun": {
    "x": 38,
    "y": 43
   }
  },
  "restoration_demonstrator_site": {
   "x": 32,
   "y": 49
  },
  "stability_window_ticks": 300,
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the exact eleven-record ledger; its plan is derived from the Mission 11 plan, inheriting doctrine, districts, and the recorded protocol.",
   "Independent readback is established by Oruun and a distinct Kharuun verifier at the neutral Meridian interface at tile 26,43 and the Kharuun interface at tile 38,43.",
   "The two recorded district inputs are the exact sites the Mission 09 allocation powered, carried through the Mission 11 plan.",
   "The separate Future Well accepts only the Mission 10 recorded protocol, and binding a conflicting protocol fails the attempt.",
   "The activation receipt must hold for exactly 300 fixed ticks.",
   "Completion requires both district readbacks observed by the two scouts after the window holds.",
   "Losing the local core, Oruun, the verifier, the Well, or a public interface, or reaching a terminal engagement outcome, fails the attempt irreversibly."
  ],
  "prohibited_inferences": [
   "Chancellor Rhyse is represented only by attributable neutral public demonstrator apparatus; no personal presence, consent, or command is asserted.",
   "No population restoration, civilian count, or survival claim follows from the demonstrator or the readbacks.",
   "The held window establishes local protocol stability for 300 ticks, not permanence.",
   "No trust, consent, or ethical justification between factions is established.",
   "The demonstrator's public claims are its own; observation of them does not make them true.",
   "No mixed-faction command is established."
  ]
 },
