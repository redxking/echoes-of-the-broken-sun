 "ui_copy": {
  "briefing": {
   "id": "nar_m04_ui_briefing",
   "loc_key": "nar_m04_ui_briefing",
   "source_text": "A memory shard is missing from the record, and the road to it runs subsurface. Take the road the founding decision selected: root the Waystone at the roadhead, raise a Listening Spine over the vaults, and walk the bearer to the shard.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 300,
    "localization_expansion_percent": 30
   },
   "binding_status": "authored_unbound"
  },
  "objectives": [
   {
    "id": "nar_m04_ui_obj_establish_roadhead",
    "loc_key": "nar_m04_ui_obj_establish_roadhead",
    "source_text": "Uproot the Waystone and root it at the inherited roadhead.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 98,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   },
   {
    "id": "nar_m04_ui_obj_raise_spine",
    "loc_key": "nar_m04_ui_obj_raise_spine",
    "source_text": "Raise a Listening Spine at the survey site while the road holds.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 104,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   },
   {
    "id": "nar_m04_ui_obj_recover_shard",
    "loc_key": "nar_m04_ui_obj_recover_shard",
    "source_text": "Bring the memory bearer to the shard site to make the recovery.",
    "placeholders": {},
    "text_budget": {
     "max_characters": 103,
     "localization_expansion_percent": 30
    },
    "binding_status": "authored_unbound"
   }
  ]
 },
 "lines": [
  {
   "id": "nar_m04_line_op_road_001",
   "loc_key": "nar_m04_line_op_road_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Something is missing from the record, and the record knows it. A shard, unburied by nobody, waiting on a road we stopped walking.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 169,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_op_road_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_op_inherit_002",
   "loc_key": "nar_m04_line_op_inherit_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The founding decision picked our road for us. My accounts have opinions about all three. Today we only get to test one.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 159,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_op_inherit_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_op_method_003",
   "loc_key": "nar_m04_line_op_method_003",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Waystone first, at the roadhead. A road without an anchor is a rumor with a direction.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 126,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_op_method_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_op_vaults_004",
   "loc_key": "nar_m04_line_op_vaults_004",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The vaults under this ground are older than my oldest account, and she claims to remember the sun before it broke. Walk carefully.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 170,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_op_vaults_004",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_road_confirm_001",
   "loc_key": "nar_m04_line_road_confirm_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_roadhead_established",
   "delivery_channel": "command_radio",
   "source_text": "Roadhead is anchored. The Waystone took to the ground like it remembered it. Perhaps it does.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 133,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_road_confirm_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_road_spine_002",
   "loc_key": "nar_m04_line_road_spine_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_roadhead_established",
   "delivery_channel": "command_radio",
   "source_text": "Now the Listening Spine. Before we take anything from this road, we owe it the courtesy of hearing what it holds.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 153,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_road_spine_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_spine_confirm_001",
   "loc_key": "nar_m04_line_spine_confirm_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_spine_raised",
   "delivery_channel": "command_radio",
   "source_text": "The Spine is up and listening. The strata carry more voices than my seven, and none of them agree either. Reassuring, in its way.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 169,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_spine_confirm_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_spine_bearer_002",
   "loc_key": "nar_m04_line_spine_bearer_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_spine_raised",
   "delivery_channel": "command_radio",
   "source_text": "Bearer forward, to the shard site. Slow steps. What was left unburied this long can wait a few minutes more for care.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 157,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_spine_bearer_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_complete_shard_001",
   "loc_key": "nar_m04_line_complete_shard_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_shard_recovered",
   "delivery_channel": "command_radio",
   "source_text": "The bearer holds the shard. The road gave up what it kept, and the record has one gap fewer.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 132,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_complete_shard_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_complete_dispute_002",
   "loc_key": "nar_m04_line_complete_dispute_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_shard_recovered",
   "delivery_channel": "command_radio",
   "source_text": "One shard recovered does not settle what the Assembly argues about. It gives the argument better material. That is the most memory ever does.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 181,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_complete_dispute_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_complete_road_003",
   "loc_key": "nar_m04_line_complete_road_003",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_shard_recovered",
   "delivery_channel": "command_radio",
   "source_text": "Mark the road open in the accounts. Eighth account, first entry: the way is walkable, and we walked it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 143,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_complete_road_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_fail_core_001",
   "loc_key": "nar_m04_line_fail_core_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The command core is gone. A road with no authority behind it closes on its own.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 119,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_fail_core_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_fail_bearer_002",
   "loc_key": "nar_m04_line_fail_bearer_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The memory bearer is lost. The shard stays where it lay, and the gap in the record keeps its shape.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 139,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_fail_bearer_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_fail_waystone_003",
   "loc_key": "nar_m04_line_fail_waystone_003",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The Waystone is destroyed. The roadhead is an anchor no longer; the road is a rumor again.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 130,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_fail_waystone_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_fail_terminal_004",
   "loc_key": "nar_m04_line_fail_terminal_004",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The engagement has gone terminal. Whatever the road holds, it keeps it today.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 117,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m04_vo_fail_terminal_004",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m04_line_fail_generic_005",
   "loc_key": "nar_m04_line_fail_generic_005",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m04_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The operation has failed. We withdraw, and the road stays unburied and unwalked.",
   "placeholders": {},
