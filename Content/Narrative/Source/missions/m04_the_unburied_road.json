 "canon": {
  "title": "The Unburied Road",
  "purpose": "Oruun-of-Seven-Stones takes mobile Kharuun infrastructure down the route the founding Well decision selected, roots the Waystone at the roadhead, raises a Listening Spine, and brings the memory bearer to the missing shard site to recover it.",
  "player_pov": "oruun_command_authority",
  "command_faction": "kharuun_assemblies",
  "memory_bearer_role": "kharuun_worker",
  "roadhead_by_founding_choice": {
   "harvest": {
    "x": 14,
    "y": 28
   },
   "preserve": {
    "x": 32,
    "y": 28
   },
   "reshape": {
    "x": 50,
    "y": 28
   }
  },
  "listening_spine_site_by_founding_choice": {
   "harvest": {
    "x": 14,
    "y": 37
   },
   "preserve": {
    "x": 32,
    "y": 37
   },
   "reshape": {
    "x": 49,
    "y": 35
   }
  },
  "memory_shard_site_by_founding_choice": {
   "harvest": {
    "x": 20,
    "y": 43
   },
   "preserve": {
    "x": 38,
    "y": 43
   },
   "reshape": {
    "x": 44,
    "y": 40
   }
  },
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the Mission 01 founding Well decision and selects one of three authored roads from it.",
   "The Harvest founding decision selects the Ash Cut, with the roadhead at tile 14,28, the Listening Spine site at tile 14,37, and the shard site at tile 20,43.",
   "The Preserve founding decision selects the Buried Causeway, with the roadhead at tile 32,28, the Listening Spine site at tile 32,37, and the shard site at tile 38,43.",
   "The Reshape founding decision selects the Folded Verge, with the roadhead at tile 50,28, the Listening Spine site at tile 49,35, and the shard site at tile 44,40.",
   "The Waystone must be rooted at the roadhead before the Listening Spine phase can begin.",
   "The Listening Spine must be complete before the shard recovery phase can begin, and completion requires the memory bearer at the shard site.",
   "Losing the local core, the memory bearer, the Waystone, or reaching a terminal engagement outcome fails the attempt irreversibly."
  ],
  "prohibited_inferences": [
   "The recovered shard does not resolve the Assembly memory dispute.",
   "No complete ancestral record is restored by recovering one shard.",
   "The shard's content is not established as authentic or infallible.",
   "Completion does not assert anything about who buried the shard or why.",
   "No claim of subsurface territory control beyond the walked road is established.",
   "The three roads' names describe terrain, not moral standing."
  ]
 },
