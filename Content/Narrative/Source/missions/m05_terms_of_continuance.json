 "canon": {
  "title": "Terms of Continuance",
  "purpose": "Mara Vey, as the Meridian treaty authority, synchronizes the Meridian relay with the Kharuun spine so drafted ceasefire terms can be read across both networks, holds the continuance window uncompromised for its authored span, and takes both treaty witnesses off the field alive. Canon continuity extension recorded 2026-09-01 with owner approval: Mara Vey alone carries Mission 05's spoken lines, consistent with her Act I Meridian command arc; the Bible's treaty and witness proxies remain unnamed.",
  "player_pov": "mara_command_authority",
  "command_faction": "meridian_compact",
  "witness_roles": "one Meridian witness proxy and one Kharuun witness proxy, both unnamed",
  "relay_site_by_founding_choice": {
   "harvest": {
    "x": 14,
    "y": 27
   },
   "preserve": {
    "x": 32,
    "y": 27
   },
   "reshape": {
    "x": 50,
    "y": 27
   }
  },
  "spine_site_by_founding_choice": {
   "harvest": {
    "x": 14,
    "y": 39
   },
   "preserve": {
    "x": 32,
    "y": 39
   },
   "reshape": {
    "x": 44,
    "y": 38
   }
  },
  "extraction_site_by_founding_choice": {
   "harvest": {
    "x": 20,
    "y": 47
   },
   "preserve": {
    "x": 32,
    "y": 47
   },
   "reshape": {
    "x": 44,
    "y": 47
   }
  },
  "continuance_window_ticks": {
   "start": 300,
   "end": 900
  },
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the Mission 01 founding Well decision and selects one of three authored accord clauses from it.",
   "The Harvest founding decision selects the Iron Clause, with the Meridian relay at tile 14,27, the Kharuun spine at tile 14,39, and the witness extraction at tile 20,47.",
   "The Preserve founding decision selects the Witness Clause, with the Meridian relay at tile 32,27, the Kharuun spine at tile 32,39, and the witness extraction at tile 32,47.",
   "The Reshape founding decision selects the Folded Clause, with the Meridian relay at tile 50,27, the Kharuun spine at tile 44,38, and the witness extraction at tile 44,47.",
   "Both the Meridian relay and the Kharuun spine must be synchronized before the continuance window phase can begin.",
   "The continuance window spans authored ticks 300 through 900 and must be held uncompromised for its full span.",
   "Completion requires both witnesses extracted alive after the window has held.",
   "Losing the local core, the Meridian relay, the Kharuun spine, or either witness, or compromising the window, fails the attempt irreversibly."
  ],
  "prohibited_inferences": [
   "No party signs or ratifies the ceasefire in this operation.",
   "The source of the pressure on the field is not identified, and no Hollow Choir involvement is established.",
   "The extracted witnesses' account is not established as accepted by either command.",
   "Holding the window does not establish that the war paused anywhere beyond this field.",
   "Mixed-faction command is not established; command authority in this operation is Meridian only.",
   "The three clauses' names describe drafting variants and terrain, not legal force."
  ]
 },
