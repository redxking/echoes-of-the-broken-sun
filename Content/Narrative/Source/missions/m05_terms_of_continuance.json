 "lines": [
  {
   "id": "nar_m05_line_op_terms_001",
   "loc_key": "nar_m05_line_op_terms_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The terms are drafted, the ground is chosen, and nobody has signed anything. What we hold today is not a peace. It is a window where one could stand.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 189,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_op_terms_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_op_networks_002",
   "loc_key": "nar_m05_line_op_networks_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Our relay and their spine have to carry one reading between them. Two networks in step, or no reading at all.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 149,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_op_networks_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_op_clause_003",
   "loc_key": "nar_m05_line_op_clause_003",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The founding decision picked the clause we read from. I would have drafted it differently. The record does not ask me.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 158,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_op_clause_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_op_witnesses_004",
   "loc_key": "nar_m05_line_op_witnesses_004",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Two witnesses, one from each side of a war neither side has stopped fighting. Their work is to watch. Ours is to keep the watchers breathing.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 181,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_op_witnesses_004",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_sync_confirm_001",
   "loc_key": "nar_m05_line_sync_confirm_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_networks_synchronized",
   "delivery_channel": "command_radio",
   "source_text": "Relay and spine are in step. Two networks that spent a war jamming each other are holding one signal. Log the tick; I want that on record.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 178,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_sync_confirm_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_sync_window_002",
   "loc_key": "nar_m05_line_sync_window_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_networks_synchronized",
   "delivery_channel": "command_radio",
   "source_text": "The window opens now and closes on schedule. Between those marks the terms read out, and nothing on this field is allowed to interrupt.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 175,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_sync_window_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_window_confirm_001",
   "loc_key": "nar_m05_line_window_confirm_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_window_held",
   "delivery_channel": "command_radio",
   "source_text": "The window held its full span. The terms are read. That is further than any accord between us has reached.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 146,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_window_confirm_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_window_extract_002",
   "loc_key": "nar_m05_line_window_extract_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_window_held",
   "delivery_channel": "command_radio",
   "source_text": "Now the witnesses. Both of them, alive, off this field. A reading with no witness is a rumor with a timestamp.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 150,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_window_extract_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_complete_witness_001",
   "loc_key": "nar_m05_line_complete_witness_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_witnesses_extracted",
   "delivery_channel": "command_radio",
   "source_text": "Both witnesses are clear. What they carry is a record of terms read in the open, once, without interruption.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 148,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_complete_witness_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_complete_unsigned_002",
   "loc_key": "nar_m05_line_complete_unsigned_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_witnesses_extracted",
   "delivery_channel": "command_radio",
   "source_text": "Nothing is signed. The pressure that leaned on this field today is not accounted for in the terms, and it has not stopped leaning.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 170,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_complete_unsigned_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_complete_record_003",
   "loc_key": "nar_m05_line_complete_record_003",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_witnesses_extracted",
   "delivery_channel": "command_radio",
   "source_text": "Log the operation closed. The window held because we held it. Whether the terms hold is not a thing this field can decide.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 162,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_complete_record_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_fail_core_001",
   "loc_key": "nar_m05_line_fail_core_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The command core is gone. A window with no authority behind it is just weather.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 119,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_fail_core_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_fail_relay_002",
   "loc_key": "nar_m05_line_fail_relay_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "Our relay is down. Half a synchronization is silence with good intentions.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 114,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_fail_relay_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_fail_spine_003",
   "loc_key": "nar_m05_line_fail_spine_003",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The Kharuun spine is dark. Whatever their command heard, the reading is over.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 117,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_fail_spine_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_fail_witness_004",
   "loc_key": "nar_m05_line_fail_witness_004",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "A witness is down. The terms may survive; the account of them will not.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 111,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_fail_witness_004",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_fail_window_005",
   "loc_key": "nar_m05_line_fail_window_005",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The window is compromised. The reading was interrupted, and an interrupted reading binds nobody.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 136,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_fail_window_005",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_fail_terminal_006",
   "loc_key": "nar_m05_line_fail_terminal_006",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The engagement has gone terminal. The field gave its answer to the terms before anyone signed them.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 139,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m05_vo_fail_terminal_006",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m05_line_fail_generic_007",
   "loc_key": "nar_m05_line_fail_generic_007",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m05_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The operation has failed. The window is closed, and the terms stay drafted and unread.",
