 "canon": {
  "title": "The Shape Beside Us",
  "purpose": "Talar Venn commands Meridian proxies through the overlap geometry the founding Well decision selected while Neme guides the traversal: reach the first echo, raise an echo relay, traverse both paired states with the state witnesses, and bring Talar to the convergence.",
  "player_pov": "talar_venn_command_authority",
  "command_faction": "meridian_compact",
