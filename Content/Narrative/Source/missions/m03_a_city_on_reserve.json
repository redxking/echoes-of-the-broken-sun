 "canon": {
  "title": "A City on Reserve",
  "purpose": "Mara Vey stabilizes an ark-city reserve grid by reconnecting the Life Support, Transit, and Archive districts in the priority order the founding Well decision selected, while every district structure and the local core must survive.",
  "player_pov": "mara_vey_command_authority",
  "command_faction": "meridian_compact",
  "district_sites": {
   "life_support": {
    "x": 24,
    "y": 10
   },
   "transit": {
    "x": 10,
    "y": 24
   },
   "archive": {
    "x": 20,
    "y": 20
   }
  },
  "priority_order_by_founding_choice": {
   "harvest": [
    "life_support",
    "transit",
    "archive"
   ],
   "preserve": [
    "archive",
    "life_support",
    "transit"
   ],
   "reshape": [
    "transit",
    "life_support",
    "archive"
   ]
  },
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the Mission 01 founding Well decision and selects one of three authored reserve plans from it.",
   "The Harvest founding decision selects the emergency load-shed plan, stabilizing Life Support, then Transit, then Archive.",
   "The Preserve founding decision selects the continuity reserve plan, stabilizing Archive, then Life Support, then Transit.",
   "The Reshape founding decision selects the manifested transit-weave plan, stabilizing Transit, then Life Support, then Archive.",
   "The Life Support district interface stands at tile 24,10, Transit at tile 10,24, and Archive at tile 20,20.",
   "Each district must be powered in the inherited order; a later district cannot be stabilized before an earlier one.",
   "Losing the local core, any district structure, or reaching a terminal engagement outcome fails the attempt irreversibly."
  ],
  "prohibited_inferences": [
   "The wider city is not fully recovered by stabilizing three districts.",
   "No claim is made about reserve consequences beyond the three reconnected interfaces.",
   "Completion does not assert civilian survival or wellbeing inside any district.",
   "The inherited priority order is not established as the correct or moral order.",
   "No consent of district populations to the chosen order is established.",
   "Grid stability beyond the held session is not established."
  ]
 },
