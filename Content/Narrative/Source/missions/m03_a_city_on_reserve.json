   "loc_key": "nar_m03_line_op_order_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m03_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The founding decision fixed the sequence. I have opinions about it. Opinions do not power a district.",
