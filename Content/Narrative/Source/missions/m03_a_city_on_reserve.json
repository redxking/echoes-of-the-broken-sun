   "loc_key": "nar_m03_line_op_method_003",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m03_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Workers to the first interface. Escort stays with them. Nothing improvised until the third district holds.",
