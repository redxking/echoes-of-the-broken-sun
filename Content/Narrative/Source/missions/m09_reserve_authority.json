 "canon": {
  "title": "Reserve Authority",
  "purpose": "Mara Vey secures branch-specific authority over a failing reserve grid where the inherited doctrine is advisory: ordinary workers power exactly two of Life Support, Transit, and Archive, and Mara herself confirms the intact deferred district. The allocation is irreversible and local.",
  "player_pov": "mara_vey_command_authority",
  "command_faction": "meridian_compact",
  "authority_site_by_founding_choice": {
   "harvest": {
    "x": 15,
    "y": 16
   },
   "preserve": {
    "x": 15,
    "y": 15
   },
   "reshape": {
    "x": 16,
    "y": 15
   }
  },
  "recommended_first_district_by_founding_choice": {
   "harvest": "life_support",
   "preserve": "archive",
   "reshape": "transit"
  },
  "relay_site_by_district": {
   "life_support": {
    "x": 17,
    "y": 12
   },
   "transit": {
    "x": 12,
    "y": 17
   },
   "archive": {
    "x": 16,
    "y": 14
   }
  },
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the Mission 01 founding Well decision as an advisory doctrine, not a binding order.",
   "The Harvest doctrine recommends Life Support first from the authority site at tile 15,16; Preserve recommends Archive first from tile 15,15; Reshape recommends Transit first from tile 16,15.",
   "Mara must secure the branch authority site before any allocation can begin.",
   "Ordinary workers power exactly two district relays: Life Support at tile 17,12, Transit at tile 12,17, or Archive at tile 16,14.",
   "The third district is deferred by the player's own allocation, and completion requires Mara standing at the deferred district while it is intact.",
   "The allocation is recorded as one irreversible local decision.",
   "Losing the local core, Mara, or any district structure, or reaching a terminal engagement outcome, fails the attempt irreversibly."
  ],
  "prohibited_inferences": [
   "No wider-city recovery follows from powering two districts.",
   "Civilian survival inside any district, powered or deferred, is not modeled and may not be claimed.",
   "The advisory doctrine is not established as correct; following or ignoring it carries no hidden score.",
   "Deferring a district does not assert its population consented to deferral.",
   "The deferred district's intact confirmation is a structural fact, not a welfare claim.",
   "No claim about future reserve capacity beyond this session is established."
  ]
 },
