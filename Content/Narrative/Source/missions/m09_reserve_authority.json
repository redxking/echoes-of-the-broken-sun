  },
  {
   "id": "nar_m09_line_fail_terminal_004",
   "loc_key": "nar_m09_line_fail_terminal_004",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The engagement has gone terminal. The reserve question stays open, which is the worst answer available.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 143,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
