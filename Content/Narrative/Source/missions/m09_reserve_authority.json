 "lines": [
  {
   "id": "nar_m09_line_op_reserve_001",
   "loc_key": "nar_m09_line_op_reserve_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The reserve carries two districts, not three. That is not a doctrine or an opinion; it is a gauge reading.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 146,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_op_reserve_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_op_doctrine_002",
   "loc_key": "nar_m09_line_op_doctrine_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The founding decision recommends an order. Recommends. The allocation is mine to make and mine to answer for, and it will not be reversible.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 180,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_op_doctrine_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_op_authority_003",
   "loc_key": "nar_m09_line_op_authority_003",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "First the authority site. I will not shed a district's load on an ordinary work order. If it is done, it is done under authority, in the record, with my name on it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 204,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_op_authority_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_op_weight_004",
   "loc_key": "nar_m09_line_op_weight_004",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Whichever district we defer, someone in it is awake right now assuming the power returns. Keep that in mind and keep working.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 165,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_op_weight_004",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_auth_secured_001",
   "loc_key": "nar_m09_line_auth_secured_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_authority_secured",
   "delivery_channel": "command_radio",
   "source_text": "Authority is secured. The allocation channel is open, and everything from here forward is on the record.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 144,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_auth_secured_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_auth_choose_002",
   "loc_key": "nar_m09_line_auth_choose_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_authority_secured",
   "delivery_channel": "command_radio",
   "source_text": "Two relays get workers. The doctrine says where to start; I have read it. Now I decide.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 127,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_auth_choose_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_first_done_001",
   "loc_key": "nar_m09_line_first_done_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_first_allocated",
   "delivery_channel": "command_radio",
   "source_text": "First district is powered and drawing steady. One more, and then the hard part of this arithmetic.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 138,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_first_done_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_second_done_001",
   "loc_key": "nar_m09_line_second_done_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_second_allocated",
   "delivery_channel": "command_radio",
   "source_text": "Second district is up. The reserve is at its ceiling. The third district stays dark by my allocation.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 141,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_second_done_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_second_walk_002",
   "loc_key": "nar_m09_line_second_walk_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_second_allocated",
   "delivery_channel": "command_radio",
   "source_text": "I am going to the deferred district myself. If I can defer it from a desk, I can stand in it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 133,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_second_walk_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_complete_deferred_001",
   "loc_key": "nar_m09_line_complete_deferred_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_deferred_confirmed",
   "delivery_channel": "command_radio",
   "source_text": "I am in the deferred district. Structures intact, systems on reserve, holding. Dark, but standing.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 138,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_complete_deferred_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_complete_record_002",
   "loc_key": "nar_m09_line_complete_record_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_deferred_confirmed",
   "delivery_channel": "command_radio",
   "source_text": "Log the allocation as final: two powered, one deferred, confirmed intact by my own eyes. The record does not say it was right. It says it was mine.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 187,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_complete_record_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_complete_cost_003",
   "loc_key": "nar_m09_line_complete_cost_003",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_deferred_confirmed",
   "delivery_channel": "command_radio",
   "source_text": "We bought the grid a future with one district's present. Price recorded. Change not given.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 130,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_complete_cost_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_fail_core_001",
   "loc_key": "nar_m09_line_fail_core_001",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The command core is down. Allocation without authority is just load-shedding with better handwriting. We stop here.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 155,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_fail_core_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_fail_mara_002",
   "loc_key": "nar_m09_line_fail_mara_002",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "I am cut off from the operation. The allocation needs its author standing, and I am not.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 128,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m09_vo_fail_mara_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m09_line_fail_district_003",
   "loc_key": "nar_m09_line_fail_district_003",
   "speaker_id": "spk_mara_vey",
   "trigger_id": "nar_m09_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "We lost a district structure. The arithmetic just changed underneath the allocation. This attempt is void.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 146,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
