 "canon": {
  "title": "Seven Accounts of Rain",
  "purpose": "Oruun-of-Seven-Stones defends a Kharuun migration route whose inherited accounts disagree about the terrain, re-roots the Waystone at the anchor the founding Well decision selected, and brings the memory bearer to the account site to make the recall.",
  "player_pov": "oruun_command_authority",
  "command_faction": "kharuun_assemblies",
  "memory_bearer_role": "kharuun_worker",
  "waystone_anchor_by_founding_choice": {
   "harvest": {
    "x": 20,
    "y": 42
   },
   "preserve": {
    "x": 35,
    "y": 40
   },
   "reshape": {
    "x": 40,
    "y": 42
   }
  },
  "account_site_by_founding_choice": {
   "harvest": {
    "x": 23,
    "y": 44
   },
   "preserve": {
    "x": 38,
    "y": 43
   },
   "reshape": {
    "x": 43,
    "y": 44
   }
  },
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the Mission 01 founding Well decision and selects one of three authored routes from it.",
   "The Harvest founding decision selects the fractured western account, with the Waystone anchor at tile 20,42 and the account site at tile 23,44.",
   "The Preserve founding decision selects the archive-verified central account, with the Waystone anchor at tile 35,40 and the account site at tile 38,43.",
   "The Reshape founding decision selects the manifested eastern account, with the Waystone anchor at tile 40,42 and the account site at tile 43,44.",
   "The operation requires the Waystone rooted at the selected anchor before the recall phase can begin.",
   "Completion requires the memory bearer standing at the selected account site while the local core, the bearer, and the Waystone survive.",
   "Losing the local core, the memory bearer, the Waystone, or reaching a terminal engagement outcome fails the attempt irreversibly."
  ],
  "prohibited_inferences": [
   "No inherited account is established as true or infallible by playing this mission.",
   "The Kharuun memory dispute is not resolved by the recall.",
   "Completion does not assert the migration herds survive beyond the held route.",
   "No claim of consent, trust, or agreement between the seven accounts is established.",
   "The recall does not establish archival authenticity of any account.",
   "No wider Kharuun political outcome follows from this single held route."
  ]
 },
