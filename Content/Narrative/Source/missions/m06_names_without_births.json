  {
   "id": "nar_m06_line_complete_bounds_002",
   "loc_key": "nar_m06_line_complete_bounds_002",
   "speaker_id": "spk_talar_venn",
   "trigger_id": "nar_m06_evt_evidence_extracted",
   "delivery_channel": "command_radio",
   "source_text": "This does not tell us who erased them, or why. It tells us the erasure happened, and now it cannot happen quietly again.",
