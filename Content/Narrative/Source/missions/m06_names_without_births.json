  },
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the Mission 01 founding Well decision and selects one of three authored census geometries from it.",
   "The Harvest founding decision selects the Foundry Roll trace, with the census at tile 16,22, the power link at 16,16, the shelter at 14,48, and the extraction at 22,44.",
   "The Preserve founding decision selects the Missing Quarter trace, with the census at tile 32,22, the power link at 28,16, the shelter at 32,48, and the extraction at 32,44.",
   "The Reshape founding decision selects the Folded Register trace, with the census at tile 48,22, the power link at 45,16, the shelter at 39,37, and the extraction at 46,37.",
   "The census evidence must be located before the archive can be stabilized, and the archive powered before the civilians can be sheltered.",
   "Both civilian proxies must be sheltered before the extraction phase, and completion requires Talar at the extraction site.",
   "Losing the local core, Talar, the archive, or either civilian proxy, or reaching a terminal engagement outcome, fails the attempt irreversibly."
  ],
  "prohibited_inferences": [
   "No cause or author of the erased census is established by the trace.",
   "Civilian outcomes beyond the two bounded proxies are not modeled and may not be claimed.",
   "The recovered evidence is not established as complete or authentic.",
   "Sheltering the proxies does not assert their consent or their trust.",
   "The missing names are not established as recoverable.",
   "No wider Compact records policy follows from one extracted trace."
  ]
 },
