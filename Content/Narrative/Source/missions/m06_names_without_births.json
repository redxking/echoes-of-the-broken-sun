   "loc_key": "nar_m06_line_op_method_002",
   "speaker_id": "spk_talar_venn",
   "trigger_id": "nar_m06_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "We are not here to decide what it means. We are here to find the census, keep it powered, and carry out what remains of it.",
