 "lines": [
  {
   "id": "nar_m06_line_op_names_001",
   "loc_key": "nar_m06_line_op_names_001",
   "speaker_id": "spk_talar_venn",
   "trigger_id": "nar_m06_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The register lists names with no births behind them. Someone recorded these people. Someone else made sure the recording did not keep.",
