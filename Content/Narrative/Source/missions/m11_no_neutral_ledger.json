 "lines": [
  {
   "id": "nar_m11_line_op_ledger_001",
   "loc_key": "nar_m11_line_op_ledger_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Ten records in the ledger, and every one of them takes a side. There is no neutral reading left. There is only walking what was written, in the open.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 189,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
