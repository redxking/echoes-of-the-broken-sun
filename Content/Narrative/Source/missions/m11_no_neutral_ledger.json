  {
   "id": "nar_m11_line_evidence_002",
   "loc_key": "nar_m11_line_evidence_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_evidence_attested",
   "delivery_channel": "command_radio",
   "source_text": "Now the Well. The recorded protocol, exactly, and nothing beside it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 108,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
