   "loc_key": "nar_m11_line_districts_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_districts_integrated",
   "delivery_channel": "command_radio",
   "source_text": "To the evidence channels. Both interfaces, both witnesses, in the open, where either faction can read the attestation.",
