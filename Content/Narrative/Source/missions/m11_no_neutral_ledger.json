    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m11_line_op_witness_003",
   "loc_key": "nar_m11_line_op_witness_003",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Two evidence interfaces, two witnesses. I attest one; a second Kharuun witness attests the other. Nobody attests their own claim today.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 175,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m11_vo_op_witness_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m11_line_op_exact_004",
   "loc_key": "nar_m11_line_op_exact_004",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "And at the Well, we apply the Lume protocol as recorded. Not improved. Not corrected. As recorded.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 138,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m11_vo_op_exact_004",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m11_line_route_001",
   "loc_key": "nar_m11_line_route_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_route_secured",
   "delivery_channel": "command_radio",
   "source_text": "The inherited route is secured. The doctrine that chose it is three missions old and still making our decisions. That is what a ledger is for.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 182,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
