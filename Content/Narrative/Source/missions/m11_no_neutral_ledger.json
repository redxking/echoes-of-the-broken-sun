   "loc_key": "nar_m11_line_evidence_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_evidence_attested",
   "delivery_channel": "command_radio",
   "source_text": "Both channels attested — Meridian interface by me, Kharuun by the second witness. The record now says witnessed, which is all attestation ever says.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 188,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
