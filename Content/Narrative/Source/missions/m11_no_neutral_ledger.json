   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m11_line_protocol_001",
   "loc_key": "nar_m11_line_protocol_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_protocol_applied",
   "delivery_channel": "command_radio",
   "source_text": "The recorded protocol is applied. The Well accepted what Lume Reach committed, because it is the same commitment, kept.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 159,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m11_vo_protocol_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m11_line_protocol_002",
   "loc_key": "nar_m11_line_protocol_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_protocol_applied",
   "delivery_channel": "command_radio",
   "source_text": "Rally the coalition at the protocol's public site. An assembly that would not gather in the open is not one I would trust to hold.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 170,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
