  },
  {
   "id": "nar_m11_line_complete_rally_001",
   "loc_key": "nar_m11_line_complete_rally_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_coalition_rallied",
   "delivery_channel": "command_radio",
   "source_text": "The coalition stands rallied at the public site. Local, bounded, and assembled over an honest ledger.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 141,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m11_vo_complete_rally_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m11_line_complete_bounds_002",
   "loc_key": "nar_m11_line_complete_bounds_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_coalition_rallied",
   "delivery_channel": "command_radio",
   "source_text": "This is not a unified command, and no one here pretends otherwise. It is two factions standing where both can see the same records. Today, that is enough.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 194,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m11_vo_complete_bounds_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m11_line_complete_accounts_003",
   "loc_key": "nar_m11_line_complete_accounts_003",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_coalition_rallied",
   "delivery_channel": "command_radio",
   "source_text": "My accounts disagree about what happens next. All seven agree about what just happened. I will take that ratio.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 151,
    "localization_expansion_percent": 30
   },
