   "loc_key": "nar_m11_line_route_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_route_secured",
   "delivery_channel": "command_radio",
   "source_text": "District contributions next. The two the allocation powered owe the coalition their share; the deferred one owes nothing and gives nothing.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 179,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
