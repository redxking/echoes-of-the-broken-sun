   "loc_key": "nar_m11_line_districts_001",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_districts_integrated",
   "delivery_channel": "command_radio",
   "source_text": "Both contributions are integrated. The deferred district's absence is itself an entry — the ledger keeps what we chose not to power.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 172,
    "localization_expansion_percent": 30
