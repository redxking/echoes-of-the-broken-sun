    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m11_line_op_plans_002",
   "loc_key": "nar_m11_line_op_plans_002",
   "speaker_id": "spk_oruun_seven_stones",
   "trigger_id": "nar_m11_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Doctrine, districts, protocol: twenty-seven ways those combine, and ours is fixed by what we actually did. My accounts appreciate the honesty of arithmetic.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 196,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
