 "lines": [
  {
   "id": "nar_m14_line_op_voices_001",
   "loc_key": "nar_m14_line_op_voices_001",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "We are several voices. Today we require one command, and we have selected yours through me. This is not surrender. It is an experiment with exact terms.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 192,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_op_voices_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_op_terms_002",
   "loc_key": "nar_m14_line_op_terms_002",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "One voice will become Possible. One will remain Manifest. The two states do not agree. They will stand in disagreement, in the open, at their own sites.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 192,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_op_terms_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_op_loom_003",
   "loc_key": "nar_m14_line_op_loom_003",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "The research loom holds what we could not decide alone. Begin with Held Alternatives. The Soldier voice selected this procedure from the alternatives it was offered — I report the selection, and leave the naming of it to your record-keepers.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 281,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_op_loom_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_op_precision_004",
   "loc_key": "nar_m14_line_op_precision_004",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_operation_started",
   "delivery_channel": "command_radio",
   "source_text": "Every placement is exact. Every protection is literal. The contract does not forgive, and we did not write it to.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 153,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_op_precision_004",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_alternatives_001",
   "loc_key": "nar_m14_line_alternatives_001",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_alternatives_researched",
   "delivery_channel": "command_radio",
   "source_text": "Held Alternatives is complete. The Soldier voice now carries its unrealized selves openly. It reports the sensation as: crowded, and clearer.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 181,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_alternatives_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_alternatives_002",
   "loc_key": "nar_m14_line_alternatives_002",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_alternatives_researched",
   "delivery_channel": "command_radio",
   "source_text": "Now the resolutions. Possible to its site; Manifest to its own. Distance is part of the honesty.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 136,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_alternatives_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_resolved_001",
   "loc_key": "nar_m14_line_resolved_001",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_voices_resolved",
   "delivery_channel": "command_radio",
   "source_text": "Both voices stand resolved and placed: one Possible, one Manifest, incompatible and simultaneous. The condition we could never hold alone is holding.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 189,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_resolved_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_resolved_002",
   "loc_key": "nar_m14_line_resolved_002",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_voices_resolved",
   "delivery_channel": "command_radio",
   "source_text": "Shared Resolution next. It was unavailable until this exact arrangement existed. Now the loom will accept it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 149,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_resolved_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_resolution_001",
   "loc_key": "nar_m14_line_resolution_001",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_resolution_researched",
   "delivery_channel": "command_radio",
   "source_text": "Shared Resolution is researched. Several voices, one command, and the command is: remain yourselves, together. We are testing whether that is possible.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 191,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_resolution_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_resolution_002",
   "loc_key": "nar_m14_line_resolution_002",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_resolution_researched",
   "delivery_channel": "command_radio",
   "source_text": "The Phase Anchor now, at the crisis site. An ordinary worker raises it. The Crownfall does not distinguish between heroic and ordinary hands, and neither do we.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 200,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_resolution_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_anchored_001",
   "loc_key": "nar_m14_line_anchored_001",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_crisis_anchored",
   "delivery_channel": "command_radio",
   "source_text": "The anchor is complete and the window opens: one hundred sixty fixed ticks. From this tick, every protection is irreversible. Repair does not restore a broken contract.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 208,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_anchored_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_anchored_002",
   "loc_key": "nar_m14_line_anchored_002",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_crisis_anchored",
   "delivery_channel": "command_radio",
   "source_text": "Hold. Everything. Exactly. Where. It. Stands.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 85,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_anchored_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_complete_held_001",
   "loc_key": "nar_m14_line_complete_held_001",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_resolution_held",
   "delivery_channel": "command_radio",
   "source_text": "The window closed with the contract intact. Two incompatible identities held under one command for the full crisis, and nothing protected was lost.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 187,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_complete_held_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_complete_bounds_002",
   "loc_key": "nar_m14_line_complete_bounds_002",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_resolution_held",
   "delivery_channel": "command_radio",
   "source_text": "This does not decide our fate. It establishes one fact: we can be commanded without being collapsed. The fact is now in your record and ours.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 181,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_complete_bounds_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_complete_neme_003",
   "loc_key": "nar_m14_line_complete_neme_003",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_resolution_held",
   "delivery_channel": "command_radio",
   "source_text": "I selected many phrasings for this moment. The accurate one is: thank you for holding still with us.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 140,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_complete_neme_003",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_fail_core_001",
   "loc_key": "nar_m14_line_fail_core_001",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "The local core is lost. The contract had exact terms, and this was outside them.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 120,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_fail_core_001",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_fail_voice_002",
   "loc_key": "nar_m14_line_fail_voice_002",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "A protected voice is gone. The disagreement we were holding has lost a party, and the experiment with it.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 145,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
   "voice_hook": {
    "id": "aud_m14_vo_fail_voice_002",
    "asset_status": "absent"
   },
   "binding_status": "authored_unbound"
  },
  {
   "id": "nar_m14_line_fail_neme_003",
   "loc_key": "nar_m14_line_fail_neme_003",
   "speaker_id": "spk_neme",
   "trigger_id": "nar_m14_evt_mission_failed",
   "delivery_channel": "command_radio",
   "source_text": "I am removed from the command site. The one command has no voice to carry it; the several remain, uncommanded.",
   "placeholders": {},
   "text_budget": {
    "max_characters": 150,
    "localization_expansion_percent": 30
   },
   "subtitle": {
    "enabled": true,
    "timing_status": "unassigned"
   },
   "transcript_included": true,
