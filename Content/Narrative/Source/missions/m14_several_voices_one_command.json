 "canon": {
  "title": "Several Voices, One Command",
  "purpose": "Neme holds one bounded Hollow Choir force under local authority: a protected Soldier voice researches Held Alternatives and resolves as Possible at its inherited site, a protected Heavy voice remains Manifest at a separate site, Shared Resolution is researched over both, a worker raises a Phase Anchor at the Crownfall crisis site, and the whole contract holds for 160 fixed ticks.",
  "player_pov": "neme_command_authority",
  "command_faction": "hollow_choir",
  "crisis_hold_ticks": 160,
  "hidden_moral_score": false,
  "canonical_facts": [
   "The mission consumes the exact thirteen-record ledger, and its sites derive from the prior plans.",
   "Command is granted only over a bounded Hollow Choir force; no other faction is commandable.",
   "The protected Soldier voice must research Held Alternatives and resolve as Possible at its inherited site.",
   "The protected Heavy voice must remain Manifest at its separate inherited site while the Soldier resolves as Possible.",
   "Shared Resolution is unavailable until the incompatible identities and placements are simultaneously authoritative.",
   "A worker raises a Phase Anchor at the Crownfall crisis site, and the crisis window holds for exactly 160 fixed ticks.",
   "Any breach after the hold begins — a protected voice, Neme, the research loom, the anchor, the local core, or a required site — fails the operation irreversibly, even if the visible state is repaired."
  ],
  "prohibited_inferences": [
   "Completion does not decide the Choir's final fate.",
   "No unified permanent Choir identity is established; the incompatibility is held, not resolved away.",
   "The crisis contract's completion does not prove broad faction balance.",
   "Neme's command is local and bounded; no Choir-wide authority is asserted.",
   "The held window does not substitute for Mission 15's endings.",
   "No claim about what the voices experience is established, only where they stood and what they resolved."
  ]
 },
