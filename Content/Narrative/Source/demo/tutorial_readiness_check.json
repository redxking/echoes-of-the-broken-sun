  "lines": [
    {
      "id": "nar_demo_line_tut_survey_01",
      "loc_key": "nar_demo_line_tut_survey_01",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_survey_opened",
      "delivery_channel": "command_radio",
      "source_text": "Before anything moves, we see the ground. Sweep the basin.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 80,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_survey_01",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_survey_02",
      "loc_key": "nar_demo_line_tut_survey_02",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_survey_opened",
      "delivery_channel": "command_radio",
      "source_text": "Edge of the world moves the view. The wheel brings it closer. {recenter_key} brings you home to the Anchor.",
      "placeholders": {
        "recenter_key": "input binding that recentres the camera on the selection"
      },
      "text_budget": {
        "max_characters": 145,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_survey_02",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_survey_03",
      "loc_key": "nar_demo_line_tut_survey_03",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_survey_verified",
      "delivery_channel": "command_radio",
      "source_text": "Good. The basin's on your board — scar, crossings, and our corridor.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 95,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_survey_03",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_survey_04",
      "loc_key": "nar_demo_line_tut_survey_04",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_survey_verified",
      "delivery_channel": "command_radio",
      "source_text": "A commander who can't look can't warn anyone. Seeing first is the cheapest thing we do.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 120,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_survey_04",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_survey_hint",
      "loc_key": "nar_demo_line_tut_survey_hint",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_survey_hint",
      "delivery_channel": "command_radio",
      "source_text": "The view answers the screen edge and the wheel. Try the corner of the world.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 105,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_survey_hint",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_roster_01",
      "loc_key": "nar_demo_line_tut_roster_01",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_roster_opened",
      "delivery_channel": "command_radio",
      "source_text": "Now the roster. Every asset answers when named. Left-click the Surveyor.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 100,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_roster_01",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_roster_02",
      "loc_key": "nar_demo_line_tut_roster_02",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_roster_verified",
      "delivery_channel": "command_radio",
      "source_text": "That ring means it's listening. Click open ground — released. Selection is a channel, not a leash.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 135,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_roster_02",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_roster_03",
      "loc_key": "nar_demo_line_tut_roster_03",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_roster_verified",
      "delivery_channel": "command_radio",
      "source_text": "You'll command forty things at once out there. Knowing exactly who's listening is the difference between an order and an accident.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 180,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_roster_03",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_roster_hint",
      "loc_key": "nar_demo_line_tut_roster_hint",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_roster_hint",
      "delivery_channel": "command_radio",
      "source_text": "One click, on the Surveyor itself. It's waiting.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 65,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_roster_hint",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_muster_01",
      "loc_key": "nar_demo_line_tut_muster_01",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_muster_opened",
      "delivery_channel": "command_radio",
      "source_text": "One at a time is for repairs. Drag a box around the whole section.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 90,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_muster_01",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_muster_02",
      "loc_key": "nar_demo_line_tut_muster_02",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_muster_verified",
      "delivery_channel": "command_radio",
      "source_text": "Whole section, one motion. That's how the Compact moves anything heavier than a wrench.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 120,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_muster_02",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_muster_03",
      "loc_key": "nar_demo_line_tut_muster_03",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_muster_verified",
      "delivery_channel": "command_radio",
      "source_text": "Duty windows are short. Muster fast, and the window is yours instead of the enemy's.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 115,
        "localization_expansion_percent": 35
      },
      "subtitle": {
        "enabled": true,
        "timing_status": "unassigned"
      },
      "transcript_included": true,
      "voice_hook": {
        "id": "aud_demo_vo_mara_tut_muster_03",
        "asset_status": "absent"
      },
      "binding_status": "authored_unbound"
    },
    {
      "id": "nar_demo_line_tut_muster_hint",
      "loc_key": "nar_demo_line_tut_muster_hint",
      "speaker_id": "spk_mara_vey",
      "trigger_id": "nar_demo_evt_tut_muster_hint",
      "delivery_channel": "command_radio",
      "source_text": "Press, drag a corner across the section, release.",
      "placeholders": {},
      "text_budget": {
        "max_characters": 70,
        "localization_expansion_percent": 35
