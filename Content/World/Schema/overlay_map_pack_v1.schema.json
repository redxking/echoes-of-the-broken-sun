{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echoes.world.overlay-map-pack.v1",
  "title": "Echoes compiled overlay map pack v1",
  "description": "Structural envelope for the compiled overlay/preset map pack. Acceptance requires the compiler's semantic validator in Content/World/Tools/compile_overlay_pack.py, not schema validation alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_format",
    "pack_version",
    "schema_version",
    "authority",
    "grid",
    "base_contract",
    "source_provenance",
    "variants",
    "claim_boundary"
  ],
  "properties": {
    "pack_format": {"const": "echoes-overlay-map-pack"},
    "pack_version": {"const": 1},
    "schema_version": {"const": 1},
    "authority": {"const": "checked-in-source-fixture"},
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_tiles",
        "height_tiles",
        "cell_count",
        "index_formula",
        "coordinate_origin"
      ],
      "properties": {
        "width_tiles": {"const": 64},
        "height_tiles": {"const": 64},
        "cell_count": {"const": 4096},
        "index_formula": {"const": "y*width+x"},
        "coordinate_origin": {"const": "southwest"}
      }
    },
    "base_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiled_pack_path", "compiled_pack_sha256"],
      "properties": {
        "compiled_pack_path": {"type": "string", "minLength": 1},
        "compiled_pack_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "runtime_mirror_commit"],
      "properties": {
        "runtime_mirror_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "raw_sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "raw_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "branch",
          "base",
          "blocked_cell_count",
          "passable_cell_count",
          "passable_component_count",
          "blocked_cell_indices",
          "sites"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "branch": {
            "enum": ["none", "harvest", "preserve", "reshape"]
          },
          "base": {"enum": ["glass-scar-v1", "open-grid"]},
          "blocked_cell_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "passable_cell_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "passable_component_count": {"type": "integer", "minimum": 1},
          "blocked_cell_indices": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0, "maximum": 4095}
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "x", "y", "passable", "reachable"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "x": {"type": "integer", "minimum": 0, "maximum": 63},
                "y": {"type": "integer", "minimum": 0, "maximum": 63},
                "passable": {"type": "boolean"},
                "reachable": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed_contract", "compiled_fixture_is_source_data", "not_evidence_for"],
      "properties": {
        "proposed_contract": {"const": true},
        "compiled_fixture_is_source_data": {"const": true},
        "not_evidence_for": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
