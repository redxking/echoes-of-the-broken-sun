{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes.invalid/schema/world/compiled-map-pack-v1",
  "title": "Echoes deterministic compiled map-pack source fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_format",
    "pack_version",
    "schema_version",
    "map_id",
    "display_name",
    "authority",
    "runtime_binding",
    "source_contract",
    "canonicalization",
    "grid",
    "movement_classes",
    "height_bands",
    "regions",
    "blocked_zones",
    "portals",
    "cells",
    "objectives",
    "camera_bounds",
    "claim_boundary"
  ],
  "properties": {
    "pack_format": {"const": "echoes-compiled-map-pack"},
    "pack_version": {"const": 1},
    "schema_version": {"const": 1},
    "map_id": {"const": "glass-scar"},
    "display_name": {"const": "Glass Scar"},
    "authority": {"const": "checked-in-source-fixture"},
    "runtime_binding": {"const": "none"},
    "source_contract": {"$ref": "#/$defs/source_contract"},
    "canonicalization": {"$ref": "#/$defs/canonicalization"},
    "grid": {"$ref": "#/$defs/grid"},
    "movement_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/compiled_movement_class"}
    },
    "height_bands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/compiled_height_band"}
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/compiled_region"}
    },
    "blocked_zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/compiled_blocked_zone"}
    },
    "portals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/compiled_portal"}
    },
    "cells": {"$ref": "#/$defs/cells"},
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/compiled_objective"}
    },
    "camera_bounds": {"$ref": "#/$defs/camera_bounds"},
    "claim_boundary": {"$ref": "#/$defs/claim_boundary"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "authoring_canonical_sha256",
        "base_descriptor_path",
        "base_descriptor_canonical_sha256"
      ],
      "properties": {
        "schema_id": {"const": "echoes.world.map-source.v2"},
        "schema_version": {"const": 2},
        "authoring_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "base_descriptor_path": {
          "const": "Content/World/Source/GlassScar/glass_scar_map_pack_v1.json"
        },
        "base_descriptor_canonical_sha256": {
          "const": "6710b95a3a2e64acdfa044a1d0c302fff529daadd7d77d987d8c4e329098bf7d"
        }
      }
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "algorithm",
        "encoding",
        "object_keys",
        "arrays",
        "whitespace",
        "terminal_newline",
        "digest_scope"
      ],
      "properties": {
        "profile": {"const": "echoes-compiled-json-v1"},
        "algorithm": {"const": "sha256"},
        "encoding": {"const": "utf-8"},
        "object_keys": {"const": "lexicographic"},
        "arrays": {"const": "contract-ordered"},
        "whitespace": {"const": "none"},
        "terminal_newline": {"const": false},
        "digest_scope": {"const": "exact-compiled-file-bytes"}
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_tiles",
        "height_tiles",
        "cell_count",
        "coordinate_origin",
        "layout",
        "index_formula",
        "movement_cost_semantics",
        "simulation_tile_centimeters",
        "presentation_tile_world_units"
      ],
      "properties": {
        "width_tiles": {"type": "integer", "minimum": 1, "maximum": 256},
        "height_tiles": {"type": "integer", "minimum": 1, "maximum": 256},
        "cell_count": {"type": "integer", "minimum": 1, "maximum": 65536},
        "coordinate_origin": {"const": "southwest"},
        "layout": {"const": "row-major-yx"},
        "index_formula": {"const": "y*width+x"},
        "movement_cost_semantics": {"const": "destination-tile-entry-cost"},
        "simulation_tile_centimeters": {"type": "integer", "minimum": 1},
        "presentation_tile_world_units": {"type": "integer", "minimum": 1}
      }
    },
    "compiled_movement_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "bit", "mask"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 7},
        "bit": {"type": "integer", "minimum": 0, "maximum": 30},
        "mask": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "compiled_height_band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "relative_level"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 15},
        "relative_level": {"type": "integer", "minimum": -8, "maximum": 7}
      }
    },
    "compiled_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "seed_index",
        "cell_count",
        "movement_mask",
        "base_move_cost",
        "height_band_ordinal"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 64},
        "seed_index": {"type": "integer", "minimum": 0, "maximum": 65535},
        "cell_count": {"type": "integer", "minimum": 1, "maximum": 65536},
        "movement_mask": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "base_move_cost": {"type": "integer", "minimum": 1, "maximum": 255},
        "height_band_ordinal": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "compiled_blocked_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "cell_count", "height_band_ordinal"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
        "cell_count": {"type": "integer", "minimum": 1, "maximum": 65536},
        "height_band_ordinal": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "index_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 65535},
        {"type": "integer", "minimum": 0, "maximum": 65535}
      ]
    },
    "compiled_portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "region_ordinals", "edge_index_pairs"],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 127},
        "region_ordinals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 64}
        },
        "edge_index_pairs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/index_pair"}
        }
      }
    },
    "cells": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movement_mask",
        "base_move_cost",
        "height_band_ordinal",
        "region_ordinal"
      ],
      "properties": {
        "movement_mask": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}
        },
        "base_move_cost": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {"type": "integer", "minimum": 0, "maximum": 255}
        },
        "height_band_ordinal": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {"type": "integer", "minimum": 0, "maximum": 15}
        },
        "region_ordinal": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {"type": "integer", "minimum": 0, "maximum": 64}
        }
      }
    },
    "compiled_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "index", "region_ordinal"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 15},
        "index": {"type": "integer", "minimum": 0, "maximum": 65535},
        "region_ordinal": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "compiled_objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ordinal",
        "type",
        "primary_index",
        "primary_region_ordinal",
        "fallback_policy",
        "fallbacks"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/stable_id"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
        "type": {"enum": ["future-well"]},
        "primary_index": {"type": "integer", "minimum": 0, "maximum": 65535},
        "primary_region_ordinal": {"type": "integer", "minimum": 1, "maximum": 64},
        "fallback_policy": {"const": "first-passable-in-order"},
        "fallbacks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/compiled_fallback"}
        }
      }
    },
    "camera_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_semantics",
        "min_x",
        "min_y",
        "max_x_exclusive",
        "max_y_exclusive"
      ],
      "properties": {
        "coordinate_semantics": {"const": "half-open-tile-edges"},
        "min_x": {"type": "integer", "minimum": 0, "maximum": 255},
        "min_y": {"type": "integer", "minimum": 0, "maximum": 255},
        "max_x_exclusive": {"type": "integer", "minimum": 1, "maximum": 256},
        "max_y_exclusive": {"type": "integer", "minimum": 1, "maximum": 256}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposed_contract",
        "compiled_fixture_is_source_data",
        "not_evidence_for"
      ],
      "properties": {
        "proposed_contract": {"const": true},
        "compiled_fixture_is_source_data": {"const": true},
        "not_evidence_for": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {
            "enum": [
              "runtime-authority",
              "runtime-consumption",
              "network-compatibility",
              "current-movement-costs",
              "current-height-or-slope",
              "current-region-or-portal-routing",
              "objective-fallback-execution",
              "camera-clamp-or-readability",
              "unreal-navmesh",
              "ai-or-formation-traversal",
              "rendered-or-playable-map",
              "packaged-or-performance-qualified",
              "release-readiness"
            ]
          }
        }
      }
    }
  }
}
